###############################################################################
# Set default behavior to automatically normalize line endings.
###############################################################################
* text=auto

# Keep recovery patches byte-stable for their recorded SHA-256. Git binary
# literal blocks have significant blank terminators, including the final block.
capability-evidence/*.patch text eol=lf whitespace=-blank-at-eol,-blank-at-eof
# Preserve the new SDK31 evidence hashes across Windows checkouts.
capability-evidence/AF_PENDING_SOURCE1068_SDK31_*.json -text whitespace=cr-at-eol
