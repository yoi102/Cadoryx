<UserControl x:Class="Cadoryx.wpf.Views.AssemblyConstraintsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
 xmlns:r="clr-namespace:Cadoryx.Lang;assembly=Cadoryx.Lang">
 <Expander Header="{Binding Title}" IsExpanded="False" Margin="0,0,0,16">
  <StackPanel Margin="8,8,8,10">
   <Button x:Name="FixButton" Content="{Binding FixLabel}" Command="{Binding AddFixedCommand}"
           IsEnabled="{Binding CanCreate}" Margin="0,0,0,8"/>
   <Expander Header="{I18N {x:Static r:LangKeys.AssemblyManualCoordinates}}" Margin="0,0,0,10">
    <StackPanel Margin="8,8,8,10">
   <TextBlock Text="{Binding ReferenceLabel}"/>
   <ComboBox x:Name="ReferenceInput" ItemsSource="{Binding References}" SelectedItem="{Binding SelectedReference}"
             DisplayMemberPath="Name" Margin="0,4,0,8"/>
   <TextBlock Text="{Binding PrimaryPointLabel}"/>
   <UniformGrid Columns="3" Margin="0,4,0,6">
    <mah:NumericUpDown x:Name="PrimaryXInput" Value="{Binding PrimaryX,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Minimum="-1000000" Maximum="1000000"/>
    <mah:NumericUpDown Value="{Binding PrimaryY,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Minimum="-1000000" Maximum="1000000"/>
    <mah:NumericUpDown Value="{Binding PrimaryZ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Minimum="-1000000" Maximum="1000000"/>
   </UniformGrid>
   <TextBlock Text="{Binding SecondaryPointLabel}"/>
   <UniformGrid Columns="3" Margin="0,4,0,8">
    <mah:NumericUpDown x:Name="SecondaryXInput" Value="{Binding SecondaryX,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Minimum="-1000000" Maximum="1000000"/>
    <mah:NumericUpDown Value="{Binding SecondaryY,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Minimum="-1000000" Maximum="1000000"/>
    <mah:NumericUpDown Value="{Binding SecondaryZ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Minimum="-1000000" Maximum="1000000"/>
   </UniformGrid>
   <Button x:Name="CoincidentButton" Content="{Binding CoincidentLabel}" Command="{Binding AddCoincidentCommand}"
           IsEnabled="{Binding CanCreate}" Margin="0,0,0,8"/>
   <TextBlock Text="{Binding DistanceLabel}"/>
   <mah:NumericUpDown x:Name="DistanceInput" Value="{Binding DistanceMm,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                      Minimum="0" Maximum="1000000" Margin="0,4,0,8"/>
   <Button x:Name="AddDistanceButton" Content="{Binding AddDistanceLabel}" Command="{Binding AddDistanceCommand}"
           IsEnabled="{Binding CanCreate}" Margin="0,0,0,8"/>
   <TextBlock Text="{Binding PrimaryAxisLabel}"/>
   <UniformGrid Columns="3" Margin="0,4,0,6">
    <mah:NumericUpDown x:Name="PrimaryAxisXInput" Value="{Binding PrimaryAxisX,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Minimum="-1000000" Maximum="1000000"/>
    <mah:NumericUpDown Value="{Binding PrimaryAxisY,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Minimum="-1000000" Maximum="1000000"/>
    <mah:NumericUpDown Value="{Binding PrimaryAxisZ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Minimum="-1000000" Maximum="1000000"/>
   </UniformGrid>
   <TextBlock Text="{Binding SecondaryAxisLabel}"/>
   <UniformGrid Columns="3" Margin="0,4,0,8">
    <mah:NumericUpDown x:Name="SecondaryAxisXInput" Value="{Binding SecondaryAxisX,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Minimum="-1000000" Maximum="1000000"/>
    <mah:NumericUpDown Value="{Binding SecondaryAxisY,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Minimum="-1000000" Maximum="1000000"/>
    <mah:NumericUpDown x:Name="SecondaryAxisZInput" Value="{Binding SecondaryAxisZ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Minimum="-1000000" Maximum="1000000"/>
   </UniformGrid>
   <UniformGrid Columns="2" IsEnabled="{Binding CanCreate}" Margin="0,0,0,8">
    <Button x:Name="ParallelButton" Content="{Binding ParallelLabel}" Command="{Binding AddParallelCommand}" Margin="0,0,3,0"/>
    <Button x:Name="CoaxialButton" Content="{Binding CoaxialLabel}" Command="{Binding AddCoaxialCommand}" Margin="3,0,0,0"/>
   </UniformGrid>
   <TextBlock Text="{Binding AngleLabel}"/>
   <mah:NumericUpDown x:Name="AngleRelationInput" Value="{Binding AngleDegrees,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                      Minimum="0" Maximum="180" Margin="0,4,0,8"/>
   <UniformGrid Columns="2" IsEnabled="{Binding CanCreate}" Margin="0,0,0,8">
    <Button x:Name="AngleRelationButton" Content="{Binding AddAngleLabel}" Command="{Binding AddAngleCommand}" Margin="0,0,3,0"/>
    <Button x:Name="PlaneRelationButton" Content="{Binding AddPlaneLabel}" Command="{Binding AddPlaneCommand}" Margin="3,0,0,0"/>
   </UniformGrid>
    </StackPanel>
   </Expander>
   <ListBox x:Name="RelationList" ItemsSource="{Binding Constraints}" SelectedItem="{Binding SelectedConstraint}"
            DisplayMemberPath="Display" MinHeight="42" MaxHeight="180" Margin="0,0,0,6"/>
   <TextBlock Text="{Binding SelectedConstraint.Explanation}" TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,8"/>
   <UniformGrid Columns="2" IsEnabled="{Binding CanEditSelected}" Margin="0,0,0,8">
    <Button x:Name="AdjustButton" Content="{Binding AdjustLabel}" Command="{Binding AdjustCommand}" Margin="0,0,3,0"/>
    <Button Content="{Binding ApplyDistanceLabel}" Command="{Binding ApplyDistanceCommand}" Margin="3,0,0,0"/>
   </UniformGrid>
   <Button Content="{Binding ApplyAngleLabel}" Command="{Binding ApplyAngleCommand}"
           IsEnabled="{Binding CanEditSelected}" Margin="0,0,0,8"/>
   <Button x:Name="PreviewSolveButton" Content="{Binding PreviewSolveLabel}" Command="{Binding PreviewSolveCommand}"
           Margin="0,0,0,6"/>
   <TextBlock Text="{Binding SolvePreviewSummary}" TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,6"/>
   <UniformGrid Columns="2" Margin="0,0,0,8">
    <Button x:Name="ConfirmSolveButton" Content="{Binding ConfirmSolveLabel}" Command="{Binding ConfirmSolveCommand}"
            IsEnabled="{Binding HasSolvePreview}" Margin="0,0,3,0"/>
    <Button x:Name="CancelSolveButton" Content="{Binding CancelSolveLabel}" Command="{Binding CancelSolvePreviewCommand}"
            Margin="3,0,0,0"/>
   </UniformGrid>
   <Separator Margin="0,4,0,8"/>
   <TextBlock Text="{Binding DatumSectionLabel}" FontWeight="SemiBold" Margin="0,0,0,6"/>
   <ComboBox ItemsSource="{Binding DatumKinds}" SelectedItem="{Binding DatumPickKind}" Margin="0,0,0,6"/>
   <Button Content="{Binding PickReferenceDatumLabel}" Command="{Binding PickReferenceDatumCommand}" Margin="0,0,0,4"/>
   <TextBlock Text="{Binding ReferenceDatumLabel}" TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,6"/>
   <Button Content="{Binding PickMovingDatumLabel}" Command="{Binding PickMovingDatumCommand}" Margin="0,0,0,4"/>
   <TextBlock Text="{Binding MovingDatumLabel}" TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,6"/>
   <ComboBox ItemsSource="{Binding DatumRelationKinds}" SelectedItem="{Binding DatumRelationKind}" Margin="0,0,0,6"/>
   <Button Content="{Binding AddDatumRelationLabel}" Command="{Binding AddDatumRelationCommand}" Margin="0,0,0,8"/>
   <Button Content="{Binding ReselectDatumRelationLabel}" Command="{Binding ReselectDatumRelationCommand}"
           IsEnabled="{Binding CanEditSelected}" Margin="0,0,0,8"/>
   <UniformGrid Columns="2" IsEnabled="{Binding CanEditSelected}" Margin="0,0,0,8">
    <Button x:Name="ApplyAnchorsButton" Content="{Binding ApplyAnchorsLabel}" Command="{Binding ApplyAnchorsCommand}" Margin="0,0,3,0"/>
    <Button x:Name="ApplyAxesButton" Content="{Binding ApplyAxesLabel}" Command="{Binding ApplyAxesCommand}" Margin="3,0,0,0"/>
   </UniformGrid>
   <Button Content="{Binding RetargetLabel}" Command="{Binding RetargetCommand}"
           IsEnabled="{Binding CanEditSelected}" Margin="0,0,0,6"/>
   <UniformGrid Columns="2" IsEnabled="{Binding CanEditSelected}">
    <Button x:Name="ToggleButton" Content="{Binding ToggleLabel}" Command="{Binding ToggleCommand}" Margin="0,0,3,0"/>
    <Button x:Name="RemoveButton" Content="{Binding RemoveLabel}" Command="{Binding RemoveCommand}" Margin="3,0,0,0"/>
   </UniformGrid>
   <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0"/>
  </StackPanel>
 </Expander>
</UserControl>
