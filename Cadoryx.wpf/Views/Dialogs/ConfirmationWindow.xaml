<mah:MetroWindow x:Class="Cadoryx.wpf.Views.Dialogs.ConfirmationWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" xmlns:r="clr-namespace:Cadoryx.Lang;assembly=Cadoryx.Lang"
 Style="{StaticResource Cadoryx.DialogWindowStyle}" Width="580" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
 <StackPanel Margin="24">
  <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,24"/>
  <WrapPanel HorizontalAlignment="Right">
   <Button x:Name="AcceptButton" Click="AcceptClicked" Margin="0,0,8,8"/>
   <Button x:Name="DiscardButton" Click="DiscardClicked" Margin="0,0,8,8"/>
   <Button Content="{I18N {x:Static r:LangKeys.Cancel}}" IsCancel="True" IsDefault="True" Margin="0,0,0,8"/>
  </WrapPanel>
 </StackPanel>
</mah:MetroWindow>
