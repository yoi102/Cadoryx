<Window x:Class="Cadoryx.wpf.Views.Dialogs.ExportOptionsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
 Title="导出选项" Width="480" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource MaterialDesign.Brush.Background}" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
 <StackPanel Margin="24">
  <TextBlock x:Name="FormatText" FontSize="22" Margin="0,0,0,12"/>
  <TextBlock x:Name="SemanticsText" TextWrapping="Wrap" Margin="0,0,0,16"/>
  <CheckBox x:Name="VisibleCheck" Content="仅导出可见对象" IsChecked="True" Margin="0,0,0,16"/>
  <StackPanel x:Name="StlSettings">
   <TextBlock Text="线性偏差 (mm)"/>
   <mah:NumericUpDown x:Name="LinearInput" Minimum="0.0001" Maximum="1000" Value="0.1" Interval="0.05" Margin="0,4,0,12"/>
   <TextBlock Text="角度偏差 (°)"/>
   <mah:NumericUpDown x:Name="AngleInput" Minimum="0.01" Maximum="180" Value="28.64789" Margin="0,4,0,12"/>
   <CheckBox x:Name="BinaryCheck" Content="二进制 STL（取消则为 ASCII）" IsChecked="True" Margin="0,0,0,16"/>
  </StackPanel>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="取消" IsCancel="True" Margin="0,0,8,0"/>
   <Button Content="导出" IsDefault="True" Click="ExportClicked"/>
  </StackPanel>
 </StackPanel>
</Window>
