<mah:MetroWindow x:Class="Cadoryx.wpf.Views.Dialogs.ExportOptionsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
 xmlns:r="clr-namespace:Cadoryx.Lang;assembly=Cadoryx.Lang"
 Style="{StaticResource Cadoryx.DialogWindowStyle}"
 Title="{I18N {x:Static r:LangKeys.ExportOptions}}" Width="480" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource MaterialDesign.Brush.Background}" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
 <StackPanel Margin="24">
  <TextBlock x:Name="FormatText" FontSize="22" Margin="0,0,0,12"/>
  <TextBlock x:Name="SemanticsText" TextWrapping="Wrap" Margin="0,0,0,16"/>
  <CheckBox x:Name="VisibleCheck" Content="{I18N {x:Static r:LangKeys.OnlyVisibleObjects}}" IsChecked="True" Margin="0,0,0,16"/>
  <StackPanel x:Name="StlSettings">
   <TextBlock Text="{I18N {x:Static r:LangKeys.LinearDeviation}}"/>
   <mah:NumericUpDown x:Name="LinearInput" Minimum="0.0001" Maximum="1000" Value="0.1" Interval="0.05" Margin="0,4,0,12"/>
   <TextBlock Text="{I18N {x:Static r:LangKeys.AngularDeviation}}"/>
   <mah:NumericUpDown x:Name="AngleInput" Minimum="0.01" Maximum="180" Value="28.64789" Margin="0,4,0,12"/>
   <CheckBox x:Name="BinaryCheck" Content="{I18N {x:Static r:LangKeys.BinaryStl}}" IsChecked="True" Margin="0,0,0,16"/>
  </StackPanel>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="{I18N {x:Static r:LangKeys.Cancel}}" IsCancel="True" Margin="0,0,8,0"/>
   <Button Content="{I18N {x:Static r:LangKeys.Export}}" IsDefault="True" Click="ExportClicked"/>
  </StackPanel>
 </StackPanel>
</mah:MetroWindow>
