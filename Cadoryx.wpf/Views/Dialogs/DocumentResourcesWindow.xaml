<mah:MetroWindow x:Class="Cadoryx.wpf.Views.Dialogs.DocumentResourcesWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" xmlns:r="clr-namespace:Cadoryx.Lang;assembly=Cadoryx.Lang"
 xmlns:cv="clr-namespace:Cadoryx.wpf.Converters"
 Style="{StaticResource Cadoryx.DialogWindowStyle}" Title="{I18N {x:Static r:LangKeys.DocumentResources}}"
 Width="920" Height="620" MinWidth="820" MinHeight="580" WindowStartupLocation="CenterOwner">
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="{Binding DocumentName}" FontSize="20" Margin="0,0,0,8"/>
  <TextBlock Grid.Row="1" Text="{I18N {x:Static r:LangKeys.ResourceWindowHint}}" TextWrapping="Wrap" Margin="0,0,0,12"/>
  <TabControl x:Name="ResourceTabs" Grid.Row="2" IsEnabled="{Binding CanEdit}" Style="{StaticResource MahApps.Styles.TabControl}">
   <TabItem Header="{I18N {x:Static r:LangKeys.Parts}}">
    <Grid Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
     <ListBox ItemsSource="{Binding Parts}" SelectedItem="{Binding SelectedPart}" DisplayMemberPath="Name"/>
     <StackPanel Grid.Column="1" Margin="20,0,0,0">
      <TextBlock Text="{I18N {x:Static r:LangKeys.PartDefinitionName}}"/>
      <TextBox x:Name="PartNameInput" Text="{Binding PartName,UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12"/>
      <TextBlock Text="{I18N {x:Static r:LangKeys.SharedPartEditingHint}}" TextWrapping="Wrap" Margin="0,0,0,12"/>
      <Button Content="{I18N {x:Static r:LangKeys.AddPart}}" Command="{Binding AddPartCommand}" Margin="0,0,0,8"/>
      <Button Content="{I18N {x:Static r:LangKeys.Rename}}" Command="{Binding RenamePartCommand}" Margin="0,0,0,8"/>
      <Button Content="{I18N {x:Static r:LangKeys.UseAsTargetPart}}" Command="{Binding UsePartCommand}"/>
     </StackPanel>
    </Grid>
   </TabItem>
   <TabItem Header="{I18N {x:Static r:LangKeys.Layers}}">
    <Grid Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
     <ListBox ItemsSource="{Binding Layers}" SelectedItem="{Binding SelectedLayer}" DisplayMemberPath="Name"/>
     <StackPanel Grid.Column="1" Margin="20,0,0,0">
      <TextBlock Text="{I18N {x:Static r:LangKeys.Name}}"/><TextBox x:Name="LayerNameInput" Text="{Binding LayerName,UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12"/>
      <TextBlock Text="{I18N {x:Static r:LangKeys.Color}}"/>
      <mah:ColorPicker SelectedColor="{Binding LayerArgb,Mode=TwoWay,Converter={x:Static cv:UIntColorToMediaColorConverter.Instance}}" IsAlphaChannelVisible="False" Margin="0,6,0,12"/>
      <WrapPanel Margin="0,0,0,12"><CheckBox Content="{I18N {x:Static r:LangKeys.Visible}}" IsChecked="{Binding LayerVisible}" Margin="0,0,20,0"/>
       <CheckBox Content="{I18N {x:Static r:LangKeys.Locked}}" IsChecked="{Binding LayerLocked}"/></WrapPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="{I18N {x:Static r:LangKeys.ReferenceCount}}"/><TextBlock Text="{Binding LayerReferences}" Margin="8,0,0,0"/></StackPanel>
      <Button Content="{I18N {x:Static r:LangKeys.AddLayer}}" Command="{Binding AddLayerCommand}" Margin="0,0,0,8"/>
      <UniformGrid Columns="2"><Button Content="{I18N {x:Static r:LangKeys.Apply}}" Command="{Binding ApplyLayerCommand}" Margin="0,0,4,0"/>
       <Button Content="{I18N {x:Static r:LangKeys.Delete}}" Command="{Binding DeleteLayerCommand}" Margin="4,0,0,0"/></UniformGrid>
     </StackPanel>
    </Grid>
   </TabItem>
   <TabItem Header="{I18N {x:Static r:LangKeys.Materials}}">
    <Grid Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
     <ListBox ItemsSource="{Binding Materials}" SelectedItem="{Binding SelectedMaterial}" DisplayMemberPath="Name"/>
     <StackPanel Grid.Column="1" Margin="20,0,0,0">
      <TextBlock Text="{I18N {x:Static r:LangKeys.Name}}"/><TextBox x:Name="MaterialNameInput" Text="{Binding MaterialName,UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12"/>
      <TextBlock Text="{I18N {x:Static r:LangKeys.DensityKgPerM3}}"/>
      <mah:NumericUpDown x:Name="DensityInput" Value="{Binding DensityKgPerM3,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Minimum="0.000001" Margin="0,6,0,12"/>
      <TextBlock Text="{I18N {x:Static r:LangKeys.MaterialDensityHint}}" TextWrapping="Wrap" Margin="0,0,0,12"/>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="{I18N {x:Static r:LangKeys.ReferenceCount}}"/><TextBlock Text="{Binding MaterialReferences}" Margin="8,0,0,0"/></StackPanel>
      <Button Content="{I18N {x:Static r:LangKeys.AddMaterial}}" Command="{Binding AddMaterialCommand}" Margin="0,0,0,8"/>
      <UniformGrid Columns="2"><Button Content="{I18N {x:Static r:LangKeys.Apply}}" Command="{Binding ApplyMaterialCommand}" Margin="0,0,4,0"/>
       <Button Content="{I18N {x:Static r:LangKeys.Delete}}" Command="{Binding DeleteMaterialCommand}" Margin="4,0,0,0"/></UniformGrid>
     </StackPanel>
    </Grid>
   </TabItem>
  </TabControl>
  <TextBlock Grid.Row="3" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,12" MaxHeight="60"/>
  <Button Grid.Row="4" Content="{I18N {x:Static r:LangKeys.Close}}" Click="CloseClicked" HorizontalAlignment="Right" MinWidth="90"/>
 </Grid>
</mah:MetroWindow>
