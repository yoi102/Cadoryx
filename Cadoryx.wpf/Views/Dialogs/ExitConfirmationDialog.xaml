<UserControl x:Class="Cadoryx.wpf.Views.Dialogs.ExitConfirmationDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:r="clr-namespace:Cadoryx.Lang;assembly=Cadoryx.Lang"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="220"
             d:DesignWidth="450">
    <Grid Width="350" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition MinHeight="30" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,8,0,8"
                   FontSize="18"
                   FontWeight="Bold"
                   Text="{I18N {x:Static r:LangKeys.ConfirmExitTitle}}" />
        <TextBlock Grid.Row="1"
                   Margin="0,8,0,8"
                   TextWrapping="Wrap"
                   Text="{I18N {x:Static r:LangKeys.ConfirmExitMessage}}" />

        <StackPanel Grid.Row="2"
                    Margin="0,32,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button AutomationProperties.AutomationId="ExitConfirmationConfirmButton"
                    Content="{I18N {x:Static r:LangKeys.Confirm}}"
                    IsDefault="True"
                    Margin="0,0,20,0"
                    Style="{StaticResource MaterialDesignFlatSecondaryButton}"
                    Command="{x:Static md:DialogHost.CloseDialogCommand}"
                    CommandParameter="{x:Static sys:Boolean.TrueString}" />
            <Button AutomationProperties.AutomationId="ExitConfirmationCancelButton"
                    Content="{I18N {x:Static r:LangKeys.Cancel}}"
                    IsCancel="True"
                    Command="{x:Static md:DialogHost.CloseDialogCommand}"
                    CommandParameter="{x:Static sys:Boolean.FalseString}" />
        </StackPanel>
    </Grid>
</UserControl>
