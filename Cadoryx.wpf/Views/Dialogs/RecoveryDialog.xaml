<UserControl x:Class="Cadoryx.wpf.Views.Dialogs.RecoveryDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:r="clr-namespace:Cadoryx.Lang;assembly=Cadoryx.Lang"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Cadoryx.ViewModels;assembly=Cadoryx.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:RecoveryCenterViewModel}"
             Width="900"
             Height="450"
             MinWidth="650"
             MinHeight="350"
             Background="{DynamicResource MaterialDesign.Brush.Background}"
             Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{I18N {x:Static r:LangKeys.RecoveryDescription}}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16" />
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Entries}"
                  SelectedItem="{Binding SelectedEntry}"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{I18N {x:Static r:LangKeys.RecoveryName}}"
                                    Binding="{Binding Name}"
                                    Width="180">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming"
                                    Value="CharacterEllipsis" />
                            <Setter Property="ToolTip"
                                    Value="{Binding Name}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="{I18N {x:Static r:LangKeys.RecoveryOriginalPath}}"
                                    Binding="{Binding OriginalPath}"
                                    Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming"
                                    Value="CharacterEllipsis" />
                            <Setter Property="ToolTip"
                                    Value="{Binding OriginalPath}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="{I18N {x:Static r:LangKeys.RecoverySnapshotTime}}"
                                    Binding="{Binding CapturedAt,StringFormat=yyyy-MM-dd HH:mm:ss}"
                                    Width="165" />
                <DataGridTextColumn Header="{I18N {x:Static r:LangKeys.RecoverySnapshotCount}}"
                                    Binding="{Binding SnapshotCount}"
                                    Width="SizeToHeader"
                                    MinWidth="75" />
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="2"
                   Text="{Binding Status}"
                   TextWrapping="Wrap"
                   Margin="0,12"
                   MaxHeight="70" />
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="{I18N {x:Static r:LangKeys.RecoveryRefresh}}"
                    Command="{Binding RefreshCommand}"
                    Margin="0,0,8,0" />
            <Button Content="{I18N {x:Static r:LangKeys.RecoveryDiscard}}"
                    Command="{Binding DiscardCommand}"
                    Margin="0,0,8,0" />
            <Button Content="{I18N {x:Static r:LangKeys.RecoveryLater}}"
                    IsCancel="True"
                    Command="{x:Static md:DialogHost.CloseDialogCommand}"
                    CommandParameter="{x:Static sys:Boolean.FalseString}"
                    Margin="0,0,8,0" />
            <Button Content="{I18N {x:Static r:LangKeys.RecoveryRestore}}"
                    Command="{Binding RestoreCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
