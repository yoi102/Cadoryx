<mah:MetroWindow x:Class="Cadoryx.wpf.Views.DatumEditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
 xmlns:r="clr-namespace:Cadoryx.Lang;assembly=Cadoryx.Lang"
 xmlns:views="clr-namespace:Cadoryx.wpf.Views"
 Style="{StaticResource Cadoryx.DialogWindowStyle}" Title="{I18N {x:Static r:LangKeys.DatumToolsTitle}}"
 Width="1580" Height="900" MinWidth="1180" MinHeight="720" WindowStartupLocation="CenterOwner">
 <Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="{I18N {x:Static r:LangKeys.DatumToolsHint}}" TextWrapping="Wrap" Margin="0,0,0,12"/>
  <Grid Grid.Row="1" IsEnabled="{Binding CanEdit}">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
   <TabControl x:Name="ConstructionTabs" SelectedIndex="{Binding ConstructionTab}">
   <TabItem Header="{I18N {x:Static r:LangKeys.DatumPlanes}}">
   <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions>
   <Grid>
    <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DataGrid x:Name="PlaneList" ItemsSource="{Binding Planes}" SelectedItem="{Binding SelectedPlane}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
     <DataGrid.Columns>
      <DataGridTextColumn Header="{I18N {x:Static r:LangKeys.Name}}" Binding="{Binding Name}" Width="*"/>
      <DataGridTextColumn Header="{I18N {x:Static r:LangKeys.DatumKind}}" Binding="{Binding Kind}" Width="160"/>
      <DataGridTextColumn Header="{I18N {x:Static r:LangKeys.PlaneOrigin}}" Binding="{Binding Frame}" Width="180"/>
     </DataGrid.Columns>
    </DataGrid>
    <TextBlock Grid.Row="1" Text="{Binding AssociationSummary}" TextWrapping="Wrap" Margin="0,12,0,8"/>
   </Grid>
   <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
    <StackPanel>
     <Button Content="{I18N {x:Static r:LangKeys.DatumNew}}" Command="{Binding NewPlaneCommand}" HorizontalAlignment="Left"/>
     <TextBlock Text="{I18N {x:Static r:LangKeys.Part}}" Margin="0,8,0,3"/>
     <ComboBox ItemsSource="{Binding Parts}" SelectedItem="{Binding Part}" DisplayMemberPath="Label"/>
     <TextBlock Text="{I18N {x:Static r:LangKeys.Name}}" Margin="0,8,0,3"/>
     <TextBox x:Name="PlaneNameInput" Text="{Binding PlaneName, UpdateSourceTrigger=PropertyChanged}"/>
     <ComboBox ItemsSource="{Binding Kinds}" SelectedValue="{Binding Kind}" SelectedValuePath="Kind" DisplayMemberPath="Label" Margin="0,8,0,0"/>
     <TextBlock Text="{I18N {x:Static r:LangKeys.DatumPrimary}}" Margin="0,8,0,3"/>
     <ComboBox x:Name="PrimarySource" ItemsSource="{Binding Sources}" SelectedItem="{Binding Primary}" DisplayMemberPath="Label"/>
     <TextBlock Text="{I18N {x:Static r:LangKeys.DatumSecondary}}" Margin="0,8,0,3"/>
     <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding Secondary}" DisplayMemberPath="Label" IsEnabled="{Binding IsMidplane}"/>
     <TextBlock Text="{I18N {x:Static r:LangKeys.DatumValue}}" Margin="0,8,0,3"/>
     <mah:NumericUpDown x:Name="ValueInput" Value="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Minimum="-1000000" Maximum="1000000"/>
     <TextBlock Text="{I18N {x:Static r:LangKeys.DatumHinge}}" Margin="0,8,0,3"/>
     <ComboBox ItemsSource="{Binding Hinges}" SelectedItem="{Binding Hinge}" IsEnabled="{Binding IsAngle}"/>
     <TextBlock Text="{I18N {x:Static r:LangKeys.DatumAngularAxis}}" Margin="0,8,0,3"/>
     <ComboBox ItemsSource="{Binding OptionalAxes}" SelectedItem="{Binding AngularAxis}" DisplayMemberPath="Label" IsEnabled="{Binding IsAngle}"/>
     <WrapPanel Margin="0,10,0,12">
      <Button x:Name="ApplyPlaneButton" Content="{I18N {x:Static r:LangKeys.DatumApply}}" Command="{Binding ApplyPlaneCommand}" Margin="0,0,8,0"/>
      <Button Content="{I18N {x:Static r:LangKeys.DatumDelete}}" Command="{Binding DeletePlaneCommand}"/>
     </WrapPanel>
     <Button Content="{I18N {x:Static r:LangKeys.DatumDetach}}" Command="{Binding DetachPlaneCommand}" Margin="0,0,0,8" HorizontalAlignment="Left"/>
     <Separator/>
     <TextBlock Text="{I18N {x:Static r:LangKeys.Sketch}}" Margin="0,10,0,3"/>
     <ComboBox ItemsSource="{Binding Sketches}" SelectedItem="{Binding Sketch}" DisplayMemberPath="Label"/>
     <WrapPanel Margin="0,8,0,10">
      <Button x:Name="BindSketchButton" Content="{I18N {x:Static r:LangKeys.DatumBindSketch}}" Command="{Binding BindSketchCommand}" Margin="0,0,8,4"/>
      <Button Content="{I18N {x:Static r:LangKeys.DatumDetachSketch}}" Command="{Binding DetachSketchCommand}" Margin="0,0,0,4"/>
     </WrapPanel>
     <ComboBox ItemsSource="{Binding Occurrences}" SelectedItem="{Binding Occurrence}" DisplayMemberPath="Label"/>
     <Button x:Name="BindWorkPlaneButton" Content="{I18N {x:Static r:LangKeys.DatumBindWorkPlane}}" Command="{Binding BindWorkPlaneCommand}" Margin="0,8,0,4" HorizontalAlignment="Left"/>
     <Button Content="{I18N {x:Static r:LangKeys.DatumDetachWorkPlane}}" Command="{Binding DetachWorkPlaneCommand}" Margin="0,4,0,6" HorizontalAlignment="Left"/>
    </StackPanel>
   </ScrollViewer>
   </Grid>
   </TabItem>
   <TabItem Header="{I18N {x:Static r:LangKeys.DatumAxes}}"><views:DatumAxisEditorPanel x:Name="AxisPanel"/></TabItem>
   <TabItem Header="{I18N {x:Static r:LangKeys.DatumPoints}}"><views:DatumPointEditorPanel x:Name="PointPanel"/></TabItem>
   </TabControl>
   <Grid Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="210"/><RowDefinition/></Grid.RowDefinitions>
    <StackPanel>
     <TextBlock Text="{I18N {x:Static r:LangKeys.DatumNativeSource}}"/>
     <ComboBox x:Name="NativeSourceInput" ItemsSource="{Binding NativeSources}" SelectedItem="{Binding NativeSource}" DisplayMemberPath="Label" Margin="0,4,0,6"/>
     <CheckBox Content="{I18N {x:Static r:LangKeys.DatumPickEdge}}" IsChecked="{Binding PickEdges}" Margin="0,0,0,6"/>
     <TextBlock Text="{I18N {x:Static r:LangKeys.DatumNativeHint}}" TextWrapping="Wrap" Margin="0,0,0,8"/>
    </StackPanel>
    <Border Grid.Row="1" Background="#202732"><Border x:Name="ViewportContainer"/></Border>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
     <ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers><DataTrigger Binding="{Binding IsPlaneConstruction}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
     </Style></ScrollViewer.Style>
     <StackPanel>
      <TextBlock Text="{Binding PlaneEvidence}" TextWrapping="Wrap"/>
      <TextBlock Text="{I18N {x:Static r:LangKeys.PlaneOrigin}}" Margin="0,6,0,3"/>
      <UniformGrid Columns="3">
       <mah:NumericUpDown Value="{Binding PlaneSourceFrame.X,UpdateSourceTrigger=PropertyChanged}" Minimum="-1000000" Maximum="1000000"/>
       <mah:NumericUpDown Value="{Binding PlaneSourceFrame.Y,UpdateSourceTrigger=PropertyChanged}" Minimum="-1000000" Maximum="1000000"/>
       <mah:NumericUpDown Value="{Binding PlaneSourceFrame.Z,UpdateSourceTrigger=PropertyChanged}" Minimum="-1000000" Maximum="1000000"/>
      </UniformGrid>
      <TextBlock Text="{I18N {x:Static r:LangKeys.DatumFrameRotation}}" Margin="0,6,0,3"/>
      <UniformGrid Columns="3">
       <mah:NumericUpDown Value="{Binding PlaneSourceFrame.Rx,UpdateSourceTrigger=PropertyChanged}" Minimum="-3600" Maximum="3600"/>
       <mah:NumericUpDown Value="{Binding PlaneSourceFrame.Ry,UpdateSourceTrigger=PropertyChanged}" Minimum="-3600" Maximum="3600"/>
       <mah:NumericUpDown Value="{Binding PlaneSourceFrame.Rz,UpdateSourceTrigger=PropertyChanged}" Minimum="-3600" Maximum="3600"/>
      </UniformGrid>
      <Button x:Name="UsePickedPlaneButton" Content="{I18N {x:Static r:LangKeys.DatumUseFace}}" Command="{Binding UsePickedPlaneCommand}" Margin="0,8,0,4"/>
      <Button Content="{I18N {x:Static r:LangKeys.DatumUseIndependent}}" Command="{Binding UseIndependentPlaneCommand}" Margin="0,4,0,4"/>
      <ComboBox ItemsSource="{Binding AxisReferences}" SelectedItem="{Binding NormalAxis}" DisplayMemberPath="Label" Margin="0,8,0,4"/>
      <ComboBox ItemsSource="{Binding OptionalPoints}" SelectedItem="{Binding NormalPoint}" DisplayMemberPath="Label" Margin="0,4,0,4"/>
      <Button x:Name="UseAxisNormalButton" Content="{I18N {x:Static r:LangKeys.DatumUseAxisNormal}}" Command="{Binding UseAxisNormalCommand}" Margin="0,4,0,4"/>
     </StackPanel>
    </ScrollViewer>
    <TextBlock Grid.Row="2" Text="{Binding CurrentNativeEvidence}" TextWrapping="Wrap" Margin="0,8,0,0">
     <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsPlaneConstruction}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
   </Grid>
  </Grid>
  <TextBlock Grid.Row="2" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,10,0,10"/>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
   <Button x:Name="PreviewButton" Content="{I18N {x:Static r:LangKeys.SolveAndPreview}}" Command="{Binding PreviewCommand}" Margin="0,0,8,0"/>
   <Button x:Name="ConfirmButton" Content="{I18N {x:Static r:LangKeys.Confirm}}" Command="{Binding ConfirmCommand}" Margin="0,0,8,0"/>
   <Button x:Name="CancelButton" Content="{I18N {x:Static r:LangKeys.Cancel}}" Command="{Binding CancelCommand}"/>
  </StackPanel>
 </Grid>
</mah:MetroWindow>
