<UserControl x:Class="Cadoryx.wpf.Views.ViewportView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
 xmlns:r="clr-namespace:Cadoryx.Lang;assembly=Cadoryx.Lang">
 <Grid Background="#09101A">
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <TextBlock Text="{I18N {x:Static r:LangKeys.ViewportInteractionHint}}" Foreground="#B0C1D8" Margin="12,8"/>
  <Grid x:Name="HostPanel" Grid.Row="1"/>
  <Border Grid.Column="1" Grid.RowSpan="2" Background="{DynamicResource MaterialDesign.Brush.Background}" Padding="12">
   <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
     <TextBlock Text="{I18N {x:Static r:LangKeys.ModelingParameters}}" FontSize="18" Margin="0,0,0,10"/>
     <ComboBox SelectedValue="{Binding ToolKind}" SelectedValuePath="Tag" Margin="0,0,0,8">
      <ComboBoxItem Content="{I18N {x:Static r:LangKeys.Box}}" Tag="Box"/><ComboBoxItem Content="{I18N {x:Static r:LangKeys.Cylinder}}" Tag="Cylinder"/>
      <ComboBoxItem Content="{I18N {x:Static r:LangKeys.PolygonExtrude}}" Tag="Extrude"/><ComboBoxItem Content="{I18N {x:Static r:LangKeys.PolygonRevolve}}" Tag="Revolve"/>
     </ComboBox>
     <TextBlock Text="{I18N {x:Static r:LangKeys.Name}}"/><TextBox Text="{Binding ObjectName,UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>
     <TextBlock Text="{I18N {x:Static r:LangKeys.SizeXRadius}}"/><mah:NumericUpDown Value="{Binding SizeX}" Minimum="0.001" Margin="0,2,0,8"/>
     <TextBlock Text="{I18N {x:Static r:LangKeys.SizeY}}"/><mah:NumericUpDown Value="{Binding SizeY}" Minimum="0.001" Margin="0,2,0,8"/>
     <TextBlock Text="{I18N {x:Static r:LangKeys.SizeZDistance}}"/><mah:NumericUpDown Value="{Binding SizeZ}" Minimum="0.001" Margin="0,2,0,8"/>
     <TextBlock Text="{I18N {x:Static r:LangKeys.PositionXYZ}}"/>
     <UniformGrid Columns="3" Margin="0,2,0,8">
      <mah:NumericUpDown Value="{Binding PositionX}" HideUpDownButtons="True"/>
      <mah:NumericUpDown Value="{Binding PositionY}" HideUpDownButtons="True"/>
      <mah:NumericUpDown Value="{Binding PositionZ}" HideUpDownButtons="True"/>
     </UniformGrid>
     <TextBlock Text="{I18N {x:Static r:LangKeys.RotationAngle}}"/><mah:NumericUpDown Value="{Binding AngleDegrees}" Minimum="0.01" Maximum="360" Margin="0,2,0,8"/>
     <Expander Header="{I18N {x:Static r:LangKeys.ExtrudeRevolveProfile}}" Margin="0,0,0,8">
      <StackPanel>
       <TextBlock Text="{I18N {x:Static r:LangKeys.ProfileInstruction}}" TextWrapping="Wrap" Margin="0,6"/>
       <DataGrid ItemsSource="{Binding ProfilePoints}" AutoGenerateColumns="False" CanUserAddRows="False" Height="140">
        <DataGrid.Columns><DataGridTextColumn Header="{I18N {x:Static r:LangKeys.AxisX}}" Binding="{Binding X}" Width="*"/><DataGridTextColumn Header="{I18N {x:Static r:LangKeys.AxisY}}" Binding="{Binding Y}" Width="*"/></DataGrid.Columns>
       </DataGrid>
       <WrapPanel><Button Content="{I18N {x:Static r:LangKeys.AddPoint}}" Command="{Binding AddProfilePointCommand}"/><Button Content="{I18N {x:Static r:LangKeys.RemovePoint}}" Command="{Binding RemoveProfilePointCommand}"/></WrapPanel>
      </StackPanel>
     </Expander>
     <Button Content="{I18N {x:Static r:LangKeys.CalculatePreview}}" Command="{Binding PreviewCommand}" Margin="0,4"/>
     <UniformGrid Columns="2"><Button Content="{I18N {x:Static r:LangKeys.Confirm}}" Command="{Binding ConfirmCommand}" IsEnabled="{Binding HasPreview}" Margin="0,4,4,4"/><Button Content="{I18N {x:Static r:LangKeys.Cancel}}" Command="{Binding CancelCommand}" Margin="4,4,0,4"/></UniformGrid>
     <TextBlock Text="{I18N {x:Static r:LangKeys.BooleanInstruction}}" TextWrapping="Wrap" Margin="0,10,0,6"/>
     <UniformGrid Columns="3">
      <Button Content="{I18N {x:Static r:LangKeys.Union}}" Command="{Binding BooleanPreviewCommand}" CommandParameter="Fuse" Padding="4"/>
      <Button Content="{I18N {x:Static r:LangKeys.Difference}}" Command="{Binding BooleanPreviewCommand}" CommandParameter="Cut" Padding="4"/>
      <Button Content="{I18N {x:Static r:LangKeys.Intersection}}" Command="{Binding BooleanPreviewCommand}" CommandParameter="Common" Padding="4"/>
     </UniformGrid>
     <TextBlock Text="{Binding ToolStatus}" TextWrapping="Wrap" Margin="0,12"/>
    </StackPanel>
   </ScrollViewer>
  </Border>
 </Grid>
</UserControl>
