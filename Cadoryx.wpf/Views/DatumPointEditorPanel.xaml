<UserControl x:Class="Cadoryx.wpf.Views.DatumPointEditorPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" xmlns:r="clr-namespace:Cadoryx.Lang;assembly=Cadoryx.Lang">
 <Grid Margin="8">
  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="350"/></Grid.ColumnDefinitions>
  <DataGrid x:Name="PointList" ItemsSource="{Binding Points}" SelectedItem="{Binding SelectedPoint}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
   <DataGrid.Columns>
    <DataGridTextColumn Header="{I18N {x:Static r:LangKeys.Name}}" Binding="{Binding Name}" Width="*"/>
    <DataGridTextColumn Header="{I18N {x:Static r:LangKeys.DatumConstructionKind}}" Binding="{Binding Kind}" Width="190"/>
    <DataGridTextColumn Header="{I18N {x:Static r:LangKeys.DatumCoordinates}}" Binding="{Binding Position}" Width="200"/>
    <DataGridTextColumn Header="{I18N {x:Static r:LangKeys.DatumState}}" Binding="{Binding State}" Width="100"/>
   </DataGrid.Columns>
  </DataGrid>
  <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
   <StackPanel>
    <Button Content="{I18N {x:Static r:LangKeys.New}}" Command="{Binding NewPointCommand}" HorizontalAlignment="Left"/>
    <TextBlock Text="{I18N {x:Static r:LangKeys.Part}}" Margin="0,8,0,3"/>
    <ComboBox ItemsSource="{Binding Parts}" SelectedItem="{Binding Part}" DisplayMemberPath="Label"/>
    <TextBlock Text="{I18N {x:Static r:LangKeys.Name}}" Margin="0,8,0,3"/>
    <TextBox x:Name="PointNameInput" Text="{Binding PointName,UpdateSourceTrigger=PropertyChanged}"/>
    <ComboBox ItemsSource="{Binding PointKinds}" SelectedValue="{Binding PointKind}" SelectedValuePath="Value" DisplayMemberPath="Label" Margin="0,8,0,0"/>
    <TextBlock Text="{I18N {x:Static r:LangKeys.DatumFirstSource}}" Margin="0,8,0,3"/>
    <ComboBox ItemsSource="{Binding PointFirstSources}" SelectedItem="{Binding PointFirst}" DisplayMemberPath="Label" IsEnabled="{Binding PointNeedsFirst}"/>
    <TextBlock Text="{I18N {x:Static r:LangKeys.DatumSecondSource}}" Margin="0,8,0,3"/>
    <ComboBox ItemsSource="{Binding PointSecondSources}" SelectedItem="{Binding PointSecond}" DisplayMemberPath="Label" IsEnabled="{Binding PointNeedsSecond}"/>
    <TextBlock Text="{I18N {x:Static r:LangKeys.DatumThird}}" Margin="0,8,0,3"/>
    <ComboBox ItemsSource="{Binding PlaneReferences}" SelectedItem="{Binding PointThird}" DisplayMemberPath="Label" IsEnabled="{Binding PointNeedsThird}"/>
    <TextBlock Text="{Binding PointEvidence}" TextWrapping="Wrap" Margin="0,8,0,0"/>
    <TextBlock Text="{I18N {x:Static r:LangKeys.DatumCoordinates}}" Margin="0,8,0,3"/>
    <UniformGrid Columns="3" IsEnabled="{Binding PointNeedsCoordinates}">
     <mah:NumericUpDown x:Name="PointXInput" Value="{Binding PointX,UpdateSourceTrigger=PropertyChanged}" Minimum="-1000000" Maximum="1000000"/>
     <mah:NumericUpDown Value="{Binding PointY,UpdateSourceTrigger=PropertyChanged}" Minimum="-1000000" Maximum="1000000"/>
     <mah:NumericUpDown Value="{Binding PointZ,UpdateSourceTrigger=PropertyChanged}" Minimum="-1000000" Maximum="1000000"/>
    </UniformGrid>
    <WrapPanel Margin="0,8,0,8">
     <Button x:Name="ApplyPointButton" Content="{I18N {x:Static r:LangKeys.DatumApplyRecipe}}" Command="{Binding ApplyPointCommand}" Margin="0,0,8,0"/>
     <Button Content="{I18N {x:Static r:LangKeys.Delete}}" Command="{Binding DeletePointCommand}"/>
    </WrapPanel>
    <Button Content="{I18N {x:Static r:LangKeys.DatumDetach}}" Command="{Binding DetachPointCommand}"/>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</UserControl>
