<mah:MetroWindow x:Class="Cadoryx.wpf.Views.TechnicalDrawingWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
 xmlns:r="clr-namespace:Cadoryx.Lang;assembly=Cadoryx.Lang"
 Style="{StaticResource Cadoryx.DialogWindowStyle}"
 Title="{I18N {x:Static r:LangKeys.DrawingSheets}}"
 Width="1200" Height="800" MinWidth="960" MinHeight="620"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 AutomationProperties.AutomationId="TechnicalDrawingWindow">
 <mah:MetroWindow.Resources>
  <Style x:Key="SecondaryAction" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
   <Setter Property="Padding" Value="10,4"/><Setter Property="MinHeight" Value="32"/>
  </Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock">
   <Setter Property="Margin" Value="0,10,0,4"/><Setter Property="Opacity" Value="0.78"/>
  </Style>
 </mah:MetroWindow.Resources>
 <Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,12" LastChildFill="False">
   <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
    <Button x:Name="AddSheetButton" Content="{I18N {x:Static r:LangKeys.DrawingAddSheet}}" Click="AddSheet" Margin="0,0,8,0"/>
    <Button x:Name="AddViewButton" Content="{I18N {x:Static r:LangKeys.DrawingAddView}}" Click="AddView"/>
   </StackPanel>
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
    <Button Content="{I18N {x:Static r:LangKeys.DrawingRefresh}}" Click="RefreshViews" Style="{StaticResource SecondaryAction}" Margin="0,0,8,0"/>
    <Button Content="{I18N {x:Static r:LangKeys.DrawingPdf}}" Click="ExportPdf" Margin="0,0,8,0"/>
    <Button Content="{I18N {x:Static r:LangKeys.DrawingPrint}}" Click="Print" Style="{StaticResource SecondaryAction}"/>
   </StackPanel>
  </DockPanel>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
   <Grid Grid.Column="0" Margin="0,0,12,0">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="150"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="{I18N {x:Static r:LangKeys.DrawingSheets}}" FontWeight="SemiBold" Margin="0,0,0,6"/>
    <ListBox x:Name="SheetList" Grid.Row="1" SelectionChanged="SheetChanged" DisplayMemberPath="Name" AutomationProperties.AutomationId="DrawingSheetList"/>
    <TextBlock Grid.Row="2" Text="{I18N {x:Static r:LangKeys.View}}" FontWeight="SemiBold" Margin="0,18,0,6"/>
    <ListBox x:Name="ViewList" Grid.Row="3" SelectionChanged="ViewChanged" DisplayMemberPath="Name" AutomationProperties.AutomationId="DrawingViewList"/>
   </Grid>
   <Grid Grid.Column="1" Background="#FF696969" Margin="0,0,12,0">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="18">
     <Border x:Name="PaperHost" Background="White" HorizontalAlignment="Center" VerticalAlignment="Top"/>
    </ScrollViewer>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="12,8">
     <TextBlock Text="{I18N {x:Static r:LangKeys.DrawingZoom}}" VerticalAlignment="Center" Margin="0,0,8,0"/>
     <Slider x:Name="ZoomSlider" Minimum="0.2" Maximum="2" Value="0.55" Width="120" ValueChanged="ZoomChanged"
             VerticalAlignment="Center" AutomationProperties.AutomationId="DrawingZoom"/>
    </StackPanel>
   </Grid>
   <TabControl x:Name="InspectorTabs" Grid.Column="2" AutomationProperties.AutomationId="DrawingInspectorTabs">
    <TabItem Header="{I18N {x:Static r:LangKeys.DrawingSheetTab}}">
     <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,10,0,0">
      <StackPanel>
       <TextBlock Text="{I18N {x:Static r:LangKeys.Name}}" Style="{StaticResource FieldLabel}"/>
       <TextBox x:Name="SheetName" AutomationProperties.AutomationId="DrawingSheetName"/>
       <TextBlock Text="{I18N {x:Static r:LangKeys.DrawingTitle}}" Style="{StaticResource FieldLabel}"/>
       <TextBox x:Name="SheetTitle" AutomationProperties.AutomationId="DrawingSheetTitle"/>
       <TextBlock Text="{I18N {x:Static r:LangKeys.DrawingAuthor}}" Style="{StaticResource FieldLabel}"/>
       <TextBox x:Name="SheetAuthor" AutomationProperties.AutomationId="DrawingSheetAuthor"/>
       <TextBlock Text="{I18N {x:Static r:LangKeys.DocumentDisplayUnit}}" Style="{StaticResource FieldLabel}"/>
       <ComboBox x:Name="UnitChoice" AutomationProperties.AutomationId="DrawingUnit"/>
       <TextBlock Text="{I18N {x:Static r:LangKeys.DrawingStandard}}" Style="{StaticResource FieldLabel}"/>
       <ComboBox x:Name="StandardChoice" AutomationProperties.AutomationId="DrawingStandard"/>
       <TextBlock Text="{I18N {x:Static r:LangKeys.DrawingPaperSize}}" Style="{StaticResource FieldLabel}"/>
       <UniformGrid Columns="2">
        <TextBox x:Name="PaperWidth" ToolTip="{I18N {x:Static r:LangKeys.DrawingWidth}}" AutomationProperties.Name="{I18N {x:Static r:LangKeys.DrawingWidth}}" Margin="0,0,4,0"/>
        <TextBox x:Name="PaperHeight" ToolTip="{I18N {x:Static r:LangKeys.DrawingHeight}}" AutomationProperties.Name="{I18N {x:Static r:LangKeys.DrawingHeight}}" Margin="4,0,0,0"/>
       </UniformGrid>
       <Button x:Name="ApplySheetButton" Content="{I18N {x:Static r:LangKeys.Apply}}" Click="ApplySheet" Margin="0,16,0,0"/>
       <Button Content="{I18N {x:Static r:LangKeys.DrawingDeleteSheet}}" Click="DeleteSheet" Style="{StaticResource SecondaryAction}" Margin="0,12,0,0"/>
      </StackPanel>
     </ScrollViewer>
    </TabItem>
    <TabItem Header="{I18N {x:Static r:LangKeys.View}}">
     <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,10,0,0">
      <StackPanel>
       <TextBlock Text="{I18N {x:Static r:LangKeys.DrawingViewKind}}" Style="{StaticResource FieldLabel}"/>
       <ComboBox x:Name="KindChoice" DisplayMemberPath="Name" SelectionChanged="KindChanged"/>
       <CheckBox x:Name="LinkParentCheck" Content="{I18N {x:Static r:LangKeys.DrawingLinkParent}}" Margin="0,12,0,4"/>
       <Expander x:Name="SectionOptions" Header="{I18N {x:Static r:LangKeys.DrawingSectionPlane}}" Margin="0,8,0,0">
        <UniformGrid Columns="4" Margin="8,8,8,10">
         <TextBox x:Name="NormalX" Text="0" ToolTip="X" AutomationProperties.Name="X" Margin="0,0,4,0"/>
         <TextBox x:Name="NormalY" Text="0" ToolTip="Y" AutomationProperties.Name="Y" Margin="0,0,4,0"/>
         <TextBox x:Name="NormalZ" Text="1" ToolTip="Z" AutomationProperties.Name="Z" Margin="0,0,4,0"/>
         <TextBox x:Name="SectionOffset" Text="15" ToolTip="{I18N {x:Static r:LangKeys.SectionOffset}}" AutomationProperties.Name="{I18N {x:Static r:LangKeys.SectionOffset}}"/>
        </UniformGrid>
       </Expander>
       <Expander x:Name="DetailOptions" Header="{I18N {x:Static r:LangKeys.DrawingDetailCrop}}" Margin="0,8,0,0" Visibility="Collapsed">
        <UniformGrid Columns="3" Margin="8,8,8,10">
         <TextBox x:Name="DetailX" Text="0" ToolTip="X" AutomationProperties.Name="X" Margin="0,0,4,0"/>
         <TextBox x:Name="DetailY" Text="0" ToolTip="Y" AutomationProperties.Name="Y" Margin="0,0,4,0"/>
         <TextBox x:Name="DetailRadius" Text="10" ToolTip="Radius" AutomationProperties.Name="Radius"/>
        </UniformGrid>
       </Expander>
       <TextBlock Text="{I18N {x:Static r:LangKeys.DrawingViewProperties}}" Style="{StaticResource FieldLabel}"/>
       <UniformGrid Columns="3">
        <TextBox x:Name="ViewX" ToolTip="X" AutomationProperties.Name="X" Margin="0,0,4,0"/>
        <TextBox x:Name="ViewY" ToolTip="Y" AutomationProperties.Name="Y" Margin="0,0,4,0"/>
        <TextBox x:Name="ViewScale" ToolTip="{I18N {x:Static r:LangKeys.DrawingScale}}" AutomationProperties.Name="{I18N {x:Static r:LangKeys.DrawingScale}}"/>
       </UniformGrid>
       <Button Content="{I18N {x:Static r:LangKeys.DrawingEditView}}" Click="EditView" Margin="0,14,0,0"/>
       <TextBlock Text="{I18N {x:Static r:LangKeys.DrawingSelectSource}}" TextWrapping="Wrap" Opacity="0.72" Margin="0,16,0,6"/>
       <Button Content="{I18N {x:Static r:LangKeys.DrawingReselectSource}}" Click="ReselectView" Style="{StaticResource SecondaryAction}"/>
       <Button Content="{I18N {x:Static r:LangKeys.DrawingDeleteView}}" Click="DeleteView" Style="{StaticResource SecondaryAction}" Margin="0,12,0,0"/>
      </StackPanel>
     </ScrollViewer>
    </TabItem>
    <TabItem Header="{I18N {x:Static r:LangKeys.DrawingDimensionProperties}}">
     <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,10,0,0">
      <StackPanel>
       <ListBox x:Name="DimensionList" Height="105" SelectionChanged="DimensionChanged" DisplayMemberPath="Value" AutomationProperties.AutomationId="DrawingDimensionList"/>
       <TextBlock Text="{I18N {x:Static r:LangKeys.DrawingMeasureKind}}" Style="{StaticResource FieldLabel}"/>
       <ComboBox x:Name="MeasureChoice" DisplayMemberPath="Name" SelectionChanged="MeasureChanged"/>
       <TextBlock Text="{I18N {x:Static r:LangKeys.DrawingDatumKind}}" Style="{StaticResource FieldLabel}"/>
       <ComboBox x:Name="DatumKindChoice" DisplayMemberPath="Name"/>
       <Button x:Name="PickFirstButton" Content="{I18N {x:Static r:LangKeys.DrawingPickFirst}}" Click="PickFirst" Margin="0,12,0,4"/>
       <TextBlock x:Name="FirstEvidence" Text="—" TextWrapping="Wrap" Opacity="0.72"/>
       <Button x:Name="PickSecondButton" Content="{I18N {x:Static r:LangKeys.DrawingPickSecond}}" Click="PickSecond" Margin="0,12,0,4"/>
       <TextBlock x:Name="SecondEvidence" Text="—" TextWrapping="Wrap" Opacity="0.72"/>
       <Button x:Name="AddDimensionButton" Content="{I18N {x:Static r:LangKeys.DrawingAddDimension}}" Click="AddDimension" Margin="0,16,0,0"/>
       <Expander Header="{I18N {x:Static r:LangKeys.DrawingAppearance}}" Margin="0,16,0,0">
        <StackPanel Margin="8,8,8,10">
         <TextBlock Text="{I18N {x:Static r:LangKeys.DrawingTextPosition}}" Style="{StaticResource FieldLabel}"/>
         <UniformGrid Columns="2">
          <TextBox x:Name="DimensionX" ToolTip="X" AutomationProperties.Name="X" Margin="0,0,4,0"/>
          <TextBox x:Name="DimensionY" ToolTip="Y" AutomationProperties.Name="Y" Margin="4,0,0,0"/>
         </UniformGrid>
         <TextBlock Text="{I18N {x:Static r:LangKeys.Color}}" Style="{StaticResource FieldLabel}"/>
         <TextBox x:Name="DimensionColor" Text="#FF202020" ToolTip="ARGB"/>
         <Button Content="{I18N {x:Static r:LangKeys.DrawingApplyDimension}}" Click="ApplyDimension" Style="{StaticResource SecondaryAction}" Margin="0,10,0,0"/>
         <TextBlock Text="{I18N {x:Static r:LangKeys.DrawingTolerance}}" Style="{StaticResource FieldLabel}"/>
         <UniformGrid Columns="2">
          <TextBox x:Name="ToleranceUpper" Text="0" ToolTip="Upper" AutomationProperties.Name="Upper tolerance" Margin="0,0,4,0"/>
          <TextBox x:Name="ToleranceLower" Text="0" ToolTip="Lower" AutomationProperties.Name="Lower tolerance" Margin="4,0,0,0"/>
         </UniformGrid>
         <Button Content="{I18N {x:Static r:LangKeys.DrawingApplyTolerance}}" Click="ApplyTolerance" Style="{StaticResource SecondaryAction}" Margin="0,10,0,0"/>
        </StackPanel>
       </Expander>
       <Button Content="{I18N {x:Static r:LangKeys.DrawingReselectDimension}}" Click="ReselectDimension" Style="{StaticResource SecondaryAction}" Margin="0,8,0,0"/>
       <Button Content="{I18N {x:Static r:LangKeys.DrawingDeleteDimension}}" Click="DeleteDimension" Style="{StaticResource SecondaryAction}" Margin="0,8,0,0"/>
      </StackPanel>
     </ScrollViewer>
    </TabItem>
   </TabControl>
  </Grid>
  <TextBlock x:Name="Status" Grid.Row="2" Margin="0,10,0,0" TextWrapping="Wrap"/>
 </Grid>
</mah:MetroWindow>
