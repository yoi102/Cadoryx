<mah:MetroWindow x:Class="Cadoryx.wpf.Views.ExtrusionEditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" xmlns:r="clr-namespace:Cadoryx.Lang;assembly=Cadoryx.Lang" xmlns:db="clr-namespace:Cadoryx.Db;assembly=Cadoryx.Db"
 Style="{StaticResource Cadoryx.DialogWindowStyle}" Title="{I18N {x:Static r:LangKeys.ExtrusionAdvanced}}"
 Width="760" Height="850" MinWidth="620" MinHeight="450" WindowStartupLocation="CenterOwner">
 <DockPanel Margin="18">
  <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
   <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,10"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button x:Name="PreviewButton" Content="{I18N {x:Static r:LangKeys.SolveAndPreview}}" Command="{Binding PreviewCommand}" MinWidth="100" Margin="0,0,8,0"/>
    <Button x:Name="ConfirmButton" Content="{I18N {x:Static r:LangKeys.Confirm}}" Command="{Binding ConfirmCommand}" MinWidth="100" Margin="0,0,8,0"/>
    <Button x:Name="CancelButton" Content="{I18N {x:Static r:LangKeys.Cancel}}" Command="{Binding CancelCommand}" MinWidth="100"/>
   </StackPanel>
  </StackPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
   <StackPanel IsEnabled="{Binding CanEdit}">
    <TextBlock Text="{I18N {x:Static r:LangKeys.ExtrusionHint}}" TextWrapping="Wrap" Margin="0,0,0,12"/>
    <ComboBox x:Name="FeaturePicker" ItemsSource="{Binding Features}" SelectedItem="{Binding SelectedFeature}" DisplayMemberPath="Label" Margin="0,0,0,12"/>
    <TextBox x:Name="NameInput" Text="{Binding ObjectName,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsNew}" Margin="0,0,0,12"/>
    <ComboBox ItemsSource="{Binding Parts}" SelectedItem="{Binding SelectedPart}" DisplayMemberPath="Label" IsEnabled="{Binding IsNew}" Margin="0,0,0,12"/>
    <TextBlock Text="{I18N {x:Static r:LangKeys.ExtrusionProfile}}"/>
    <ComboBox x:Name="ProfilePicker" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Label" IsEnabled="{Binding CanChooseProfile}" Margin="0,4,0,12"/>
    <UniformGrid Columns="2">
     <StackPanel Margin="0,0,12,12"><TextBlock Text="{I18N {x:Static r:LangKeys.ExtrusionOperation}}"/><ComboBox x:Name="OperationPicker" ItemsSource="{Binding Operations}" SelectedValue="{Binding Operation}" SelectedValuePath="Value" DisplayMemberPath="Label" IsEnabled="{Binding IsNew}" Margin="0,4,0,0"/></StackPanel>
     <StackPanel Margin="0,0,0,12"><TextBlock Text="{I18N {x:Static r:LangKeys.HoleSource}}"/>
      <ComboBox x:Name="TargetPicker" ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" DisplayMemberPath="Label" IsEnabled="{Binding CanChooseTarget}" Margin="0,4,0,0">
       <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Style.Triggers><DataTrigger Binding="{Binding IsNew}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ComboBox.Style>
      </ComboBox>
      <TextBlock Text="{Binding SourceDescription}" Margin="0,4,0,0"/>
     </StackPanel>
     <StackPanel Margin="0,0,12,12"><TextBlock Text="{I18N {x:Static r:LangKeys.ExtrusionDirection}}"/><ComboBox x:Name="DirectionPicker" ItemsSource="{Binding Directions}" SelectedValue="{Binding Side}" SelectedValuePath="Value" DisplayMemberPath="Label" Margin="0,4,0,0"/></StackPanel>
     <StackPanel Margin="0,0,0,12"><TextBlock Text="{I18N {x:Static r:LangKeys.ExtrusionTermination}}"/><ComboBox x:Name="TerminationPicker" ItemsSource="{Binding Terminations}" SelectedValue="{Binding Termination}" SelectedValuePath="Value" DisplayMemberPath="Label" Margin="0,4,0,0"/></StackPanel>
     <StackPanel Margin="0,0,12,12"><TextBlock Text="{I18N {x:Static r:LangKeys.ExtrusionDistance}}"/><mah:NumericUpDown x:Name="DistanceInput" Value="{Binding Distance}" Minimum="0.001" Maximum="1000000" IsEnabled="{Binding CanSetDistance}" Margin="0,4,0,0"/></StackPanel>
     <StackPanel Margin="0,0,0,12"><TextBlock Text="{I18N {x:Static r:LangKeys.ExtrusionBackward}}"/><mah:NumericUpDown x:Name="BackwardInput" Value="{Binding Backward}" Minimum="0.001" Maximum="1000000" IsEnabled="{Binding CanSetBackward}" Margin="0,4,0,0"/></StackPanel>
    </UniformGrid>
    <TextBlock Text="{I18N {x:Static r:LangKeys.ExtrusionStartFrame}}" Margin="0,0,0,4"/>
    <UniformGrid Columns="3" IsEnabled="{Binding CanSetStart}">
     <StackPanel Margin="0,0,10,10"><TextBlock Text="X (mm)"/><mah:NumericUpDown Value="{Binding StartX}" Minimum="-1000000" Maximum="1000000"/></StackPanel>
     <StackPanel Margin="0,0,10,10"><TextBlock Text="Y (mm)"/><mah:NumericUpDown Value="{Binding StartY}" Minimum="-1000000" Maximum="1000000"/></StackPanel>
     <StackPanel Margin="0,0,0,10"><TextBlock Text="Z (mm)"/><mah:NumericUpDown x:Name="StartZInput" Value="{Binding StartZ}" Minimum="-1000000" Maximum="1000000"/></StackPanel>
     <StackPanel Margin="0,0,10,10"><TextBlock Text="RX (°)"/><mah:NumericUpDown Value="{Binding StartRx}" Minimum="-3600" Maximum="3600"/></StackPanel>
     <StackPanel Margin="0,0,10,10"><TextBlock Text="RY (°)"/><mah:NumericUpDown Value="{Binding StartRy}" Minimum="-3600" Maximum="3600"/></StackPanel>
     <StackPanel Margin="0,0,0,10"><TextBlock Text="RZ (°)"/><mah:NumericUpDown Value="{Binding StartRz}" Minimum="-3600" Maximum="3600"/></StackPanel>
    </UniformGrid>
    <StackPanel>
     <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Termination}" Value="{x:Static db:ExtrusionTermination.Plane}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
    <TextBlock Text="{I18N {x:Static r:LangKeys.ExtrusionLimitFrame}}"/>
    <ComboBox x:Name="DatumPicker" ItemsSource="{Binding Datums}" SelectedItem="{Binding SelectedDatum}" DisplayMemberPath="Label" Margin="0,4,0,12"/>
    <UniformGrid Columns="3" IsEnabled="{Binding CanSetLimit}">
     <StackPanel Margin="0,0,10,10"><TextBlock Text="X (mm)"/><mah:NumericUpDown Value="{Binding LimitX}" Minimum="-1000000" Maximum="1000000"/></StackPanel>
     <StackPanel Margin="0,0,10,10"><TextBlock Text="Y (mm)"/><mah:NumericUpDown Value="{Binding LimitY}" Minimum="-1000000" Maximum="1000000"/></StackPanel>
     <StackPanel Margin="0,0,0,10"><TextBlock Text="Z (mm)"/><mah:NumericUpDown x:Name="LimitZInput" Value="{Binding LimitZ}" Minimum="-1000000" Maximum="1000000"/></StackPanel>
     <StackPanel Margin="0,0,10,10"><TextBlock Text="RX (°)"/><mah:NumericUpDown Value="{Binding LimitRx}" Minimum="-3600" Maximum="3600"/></StackPanel>
     <StackPanel Margin="0,0,10,10"><TextBlock Text="RY (°)"/><mah:NumericUpDown x:Name="LimitRyInput" Value="{Binding LimitRy}" Minimum="-3600" Maximum="3600"/></StackPanel>
     <StackPanel Margin="0,0,0,10"><TextBlock Text="RZ (°)"/><mah:NumericUpDown Value="{Binding LimitRz}" Minimum="-3600" Maximum="3600"/></StackPanel>
    </UniformGrid>
    </StackPanel>
    <StackPanel>
     <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Termination}" Value="{x:Static db:ExtrusionTermination.PlanarFace}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
    <TextBlock Text="{I18N {x:Static r:LangKeys.ExtrusionFaceHint}}" TextWrapping="Wrap" Margin="0,4,0,8"/>
    <Button x:Name="LoadFacesButton" Content="{I18N {x:Static r:LangKeys.ExtrusionLoadFaces}}" Command="{Binding LoadFacesCommand}" HorizontalAlignment="Left"/>
    <ComboBox x:Name="FacePicker" ItemsSource="{Binding Faces}" SelectedItem="{Binding SelectedFace}" DisplayMemberPath="Label" Margin="0,6,0,12"/>
    </StackPanel>
    <StackPanel>
     <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Termination}" Value="{x:Static db:ExtrusionTermination.FiniteSurface}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
     <TextBlock Text="{I18N {x:Static r:LangKeys.ExtrusionSurfaceHint}}" TextWrapping="Wrap" Margin="0,4,0,8"/>
     <Button x:Name="LoadSurfacesButton" Content="{I18N {x:Static r:LangKeys.ExtrusionLoadFaces}}" Command="{Binding LoadFacesCommand}" HorizontalAlignment="Left"/>
     <TextBlock Text="{I18N {x:Static r:LangKeys.ExtrusionSurfaceSupport}}" Margin="0,8,0,4"/>
     <ComboBox x:Name="SupportPicker" IsEnabled="{Binding CanChooseSupport}" ItemsSource="{Binding Supports}" SelectedItem="{Binding SelectedSupport}" DisplayMemberPath="Label" Margin="0,0,0,12"/>
     <TextBlock Text="{I18N {x:Static r:LangKeys.ExtrusionSurface}}" Margin="0,0,0,4"/>
     <ComboBox x:Name="SurfacePicker" ItemsSource="{Binding Surfaces}" SelectedItem="{Binding SelectedSurface}" DisplayMemberPath="Label" Margin="0,0,0,12"/>
     <TextBlock Text="{I18N {x:Static r:LangKeys.ExtrusionSurfaceBranch}}" Margin="0,0,0,4"/>
     <ComboBox x:Name="SurfaceBranchPicker" ItemsSource="{Binding SurfaceBranches}" SelectedValue="{Binding SurfaceBranch}" SelectedValuePath="Value" DisplayMemberPath="Label" Margin="0,0,0,12"/>
    </StackPanel>
   </StackPanel>
  </ScrollViewer>
 </DockPanel>
</mah:MetroWindow>
