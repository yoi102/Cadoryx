<mah:MetroWindow x:Class="Cadoryx.wpf.Views.GuidedEditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" xmlns:r="clr-namespace:Cadoryx.Lang;assembly=Cadoryx.Lang"
 Style="{StaticResource Cadoryx.DialogWindowStyle}" Title="{Binding Title}"
 Width="900" Height="900" MinWidth="720" MinHeight="450" WindowStartupLocation="CenterOwner">
 <mah:MetroWindow.Resources>
  <DataTemplate x:Key="FrameTemplate">
   <UniformGrid Columns="3">
    <StackPanel Margin="0,0,10,8"><TextBlock Text="X (mm)"/><mah:NumericUpDown Value="{Binding X}" Minimum="-1000000" Maximum="1000000"/></StackPanel>
    <StackPanel Margin="0,0,10,8"><TextBlock Text="Y (mm)"/><mah:NumericUpDown Value="{Binding Y}" Minimum="-1000000" Maximum="1000000"/></StackPanel>
    <StackPanel Margin="0,0,0,8"><TextBlock Text="Z (mm)"/><mah:NumericUpDown Value="{Binding Z}" Minimum="-1000000" Maximum="1000000"/></StackPanel>
    <StackPanel Margin="0,0,10,8"><TextBlock Text="RX (°)"/><mah:NumericUpDown Value="{Binding Rx}" Minimum="-3600" Maximum="3600"/></StackPanel>
    <StackPanel Margin="0,0,10,8"><TextBlock Text="RY (°)"/><mah:NumericUpDown Value="{Binding Ry}" Minimum="-3600" Maximum="3600"/></StackPanel>
    <StackPanel Margin="0,0,0,8"><TextBlock Text="RZ (°)"/><mah:NumericUpDown Value="{Binding Rz}" Minimum="-3600" Maximum="3600"/></StackPanel>
   </UniformGrid>
  </DataTemplate>
  <Style x:Key="EditorButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="MinWidth" Value="90"/></Style>
 </mah:MetroWindow.Resources>
 <DockPanel Margin="18">
  <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
   <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,10"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button x:Name="PreviewButton" Content="{I18N {x:Static r:LangKeys.SolveAndPreview}}" Command="{Binding PreviewCommand}" Style="{StaticResource EditorButton}"/>
    <Button x:Name="ConfirmButton" Content="{I18N {x:Static r:LangKeys.Confirm}}" Command="{Binding ConfirmCommand}" Style="{StaticResource EditorButton}"/>
    <Button x:Name="CancelButton" Content="{I18N {x:Static r:LangKeys.Cancel}}" Command="{Binding CancelCommand}" Style="{StaticResource EditorButton}"/>
   </StackPanel>
  </StackPanel>
  <ScrollViewer x:Name="EditorScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel IsEnabled="{Binding CanEdit}">
    <TextBlock Text="{I18N {x:Static r:LangKeys.GuidedHint}}" TextWrapping="Wrap" Margin="0,0,0,12"/>
    <UniformGrid Columns="2">
     <StackPanel Margin="0,0,12,12"><TextBlock Text="{I18N {x:Static r:LangKeys.Name}}"/><TextBox x:Name="NameInput" Text="{Binding ObjectName,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsNew}" Margin="0,4,0,0"/></StackPanel>
     <StackPanel Margin="0,0,0,12"><TextBlock Text="{I18N {x:Static r:LangKeys.Part}}"/><ComboBox x:Name="PartPicker" ItemsSource="{Binding Parts}" SelectedItem="{Binding SelectedPart}" DisplayMemberPath="Label" IsEnabled="{Binding IsNew}" Margin="0,4,0,0"/></StackPanel>
    </UniformGrid>
    <TextBlock Text="{I18N {x:Static r:LangKeys.GuidedOutput}}"/>
    <ComboBox x:Name="OutputPicker" ItemsSource="{Binding Outputs}" SelectedValue="{Binding Output}" SelectedValuePath="Value" DisplayMemberPath="Label" Margin="0,4,0,12"/>
    <StackPanel x:Name="SweepPanel">
     <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsSweep}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
     <TextBlock Text="{I18N {x:Static r:LangKeys.GuidedSection}}"/>
     <ComboBox x:Name="SectionPicker" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedSweepProfile}" DisplayMemberPath="Label" Margin="0,4,0,8"/>
     <Button x:Name="DetachSectionButton" Content="{I18N {x:Static r:LangKeys.GuidedDetach}}" Command="{Binding DetachSectionCommand}" Style="{StaticResource EditorButton}" HorizontalAlignment="Left"/>
     <ContentControl x:Name="SectionFrameEditor" Content="{Binding SectionFrame}" ContentTemplate="{StaticResource FrameTemplate}" IsEnabled="{Binding CanSetSectionFrame}"/>
     <TextBlock Text="{I18N {x:Static r:LangKeys.GuidedPathHint}}" TextWrapping="Wrap" Margin="0,8,0,8"/>
     <ComboBox x:Name="PathSketchPicker" ItemsSource="{Binding PathSketches}" SelectedItem="{Binding SelectedPathSketch}" DisplayMemberPath="Label" Margin="0,0,0,8"/>
     <ComboBox x:Name="AvailableEdgePicker" ItemsSource="{Binding AvailableEdges}" SelectedItem="{Binding SelectedAvailableEdge}" DisplayMemberPath="Label" Margin="0,0,0,8"/>
     <WrapPanel>
      <Button x:Name="AddEdgeButton" Content="{I18N {x:Static r:LangKeys.GuidedAddEdge}}" Command="{Binding AddEdgeCommand}" Style="{StaticResource EditorButton}"/>
      <Button x:Name="RemoveEdgeButton" Content="{I18N {x:Static r:LangKeys.Delete}}" Command="{Binding RemoveEdgeCommand}" Style="{StaticResource EditorButton}"/>
      <Button x:Name="EdgeUpButton" Content="{I18N {x:Static r:LangKeys.GuidedUp}}" Command="{Binding MoveEdgeUpCommand}" Style="{StaticResource EditorButton}"/>
      <Button x:Name="EdgeDownButton" Content="{I18N {x:Static r:LangKeys.GuidedDown}}" Command="{Binding MoveEdgeDownCommand}" Style="{StaticResource EditorButton}"/>
     </WrapPanel>
     <ListBox x:Name="PathEdgesList" ItemsSource="{Binding PathEdges}" SelectedItem="{Binding SelectedPathEdge}" Height="125" Margin="0,0,0,8" HorizontalContentAlignment="Stretch">
      <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap"/>
       <CheckBox Grid.Column="1" Content="{I18N {x:Static r:LangKeys.GuidedReverse}}" IsChecked="{Binding Reverse,UpdateSourceTrigger=PropertyChanged}" Margin="12,4,0,4"/>
      </Grid></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <Button x:Name="DetachPathButton" Content="{I18N {x:Static r:LangKeys.GuidedDetach}}" Command="{Binding DetachPathCommand}" Style="{StaticResource EditorButton}" HorizontalAlignment="Left"/>
     <ContentControl x:Name="PathFrameEditor" Content="{Binding PathFrame}" ContentTemplate="{StaticResource FrameTemplate}" IsEnabled="{Binding CanSetPathFrame}"/>
     <TextBlock Text="{I18N {x:Static r:LangKeys.GuidedCorner}}" Margin="0,4,0,0"/>
     <ComboBox x:Name="CornerPicker" ItemsSource="{Binding Corners}" SelectedValue="{Binding Corner}" SelectedValuePath="Value" DisplayMemberPath="Label" Margin="0,4,0,10"/>
    </StackPanel>
    <StackPanel x:Name="LoftPanel">
     <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsLoft}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
     <TextBlock Text="{I18N {x:Static r:LangKeys.GuidedLoftHint}}" TextWrapping="Wrap" Margin="0,0,0,10"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,12,0"><TextBlock Text="{I18N {x:Static r:LangKeys.GuidedStations}}"/>
       <ListBox x:Name="StationsList" ItemsSource="{Binding Stations}" SelectedItem="{Binding SelectedStation}" DisplayMemberPath="Label" Height="140" Margin="0,4,0,8"/>
       <WrapPanel><Button x:Name="AddStationButton" Content="{I18N {x:Static r:LangKeys.GuidedAddStation}}" Command="{Binding AddStationCommand}" Style="{StaticResource EditorButton}"/>
        <Button x:Name="RemoveStationButton" Content="{I18N {x:Static r:LangKeys.Delete}}" Command="{Binding RemoveStationCommand}" Style="{StaticResource EditorButton}"/>
        <Button x:Name="StationUpButton" Content="{I18N {x:Static r:LangKeys.GuidedUp}}" Command="{Binding MoveStationUpCommand}" Style="{StaticResource EditorButton}"/>
        <Button x:Name="StationDownButton" Content="{I18N {x:Static r:LangKeys.GuidedDown}}" Command="{Binding MoveStationDownCommand}" Style="{StaticResource EditorButton}"/>
       </WrapPanel>
      </StackPanel>
      <StackPanel Grid.Column="1"><TextBlock Text="{I18N {x:Static r:LangKeys.GuidedChannels}}"/>
       <ListBox x:Name="ChannelsList" ItemsSource="{Binding Channels}" SelectedItem="{Binding SelectedChannel}" Height="140" Margin="0,4,0,8" HorizontalContentAlignment="Stretch">
        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate>
       </ListBox>
       <WrapPanel><Button x:Name="AddChildButton" Content="{I18N {x:Static r:LangKeys.GuidedAddChild}}" Command="{Binding AddChildCommand}" Style="{StaticResource EditorButton}"/>
        <Button x:Name="RemoveChannelButton" Content="{I18N {x:Static r:LangKeys.Delete}}" Command="{Binding RemoveChannelCommand}" Style="{StaticResource EditorButton}"/>
       </WrapPanel>
      </StackPanel>
     </Grid>
     <TextBlock Text="{Binding AssignmentDescription}" TextWrapping="Wrap" Margin="0,4,0,8"/>
     <ComboBox x:Name="AssignmentProfilePicker" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedAssignmentProfile}" DisplayMemberPath="Label" Margin="0,0,0,8"/>
     <WrapPanel><Button x:Name="AssignProfileButton" Content="{I18N {x:Static r:LangKeys.GuidedAssign}}" Command="{Binding AssignProfileCommand}" Style="{StaticResource EditorButton}"/>
      <Button x:Name="DetachStationButton" Content="{I18N {x:Static r:LangKeys.GuidedDetach}}" Command="{Binding DetachStationCommand}" Style="{StaticResource EditorButton}"/>
     </WrapPanel>
     <ContentControl x:Name="StationFrameEditor" Content="{Binding SelectedStation.Frame}" ContentTemplate="{StaticResource FrameTemplate}" IsEnabled="{Binding SelectedStation.CanSetFrame}"/>
     <CheckBox x:Name="RuledCheckBox" Content="{I18N {x:Static r:LangKeys.GuidedRuled}}" IsChecked="{Binding Ruled}" Margin="0,8,0,8"/>
    </StackPanel>
   </StackPanel>
  </ScrollViewer>
 </DockPanel>
</mah:MetroWindow>
