<mah:MetroWindow x:Class="Cadoryx.wpf.Views.LocalFeatureWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
 xmlns:r="clr-namespace:Cadoryx.Lang;assembly=Cadoryx.Lang"
 Style="{StaticResource Cadoryx.DialogWindowStyle}" Title="{I18N {x:Static r:LangKeys.LocalFeatureTitle}}"
 Width="1120" Height="740" MinWidth="920" MinHeight="600" WindowStartupLocation="CenterOwner">
 <Grid Margin="12">
  <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
  <Border x:Name="ViewportContainer" Margin="0,0,14,0"/>
  <StackPanel Grid.Column="1">
   <StackPanel IsEnabled="{Binding CanChooseSource}">
    <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
    <TextBlock Text="{I18N {x:Static r:LangKeys.LocalFeatureScope}}" TextWrapping="Wrap" Margin="0,0,0,14"/>
    <TextBlock Text="{Binding SourceBodyLabel}"/><ComboBox ItemsSource="{Binding Boxes}" SelectedItem="{Binding SelectedBox}" DisplayMemberPath="Label" Margin="0,4,0,10"/>
    <TextBlock Text="{Binding ChainedSourceHint}" TextWrapping="Wrap" Margin="0,0,0,8">
     <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsChainedSource}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
    <TextBlock Text="{I18N {x:Static r:LangKeys.SelectionKind}}"/><ComboBox ItemsSource="{Binding Kinds}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SelectionKind}" Margin="0,4,0,10"/>
   </StackPanel>
   <StackPanel IsEnabled="{Binding CanEdit}">
    <TextBlock Text="{I18N {x:Static r:LangKeys.LocalFeatureOperation}}"/><ComboBox ItemsSource="{Binding Operations}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Operation}" IsEnabled="{Binding CanChangeOperation}" Margin="0,4,0,10"/>
    <TextBlock Text="{I18N {x:Static r:LangKeys.RadiusOrDistance}}"/><mah:NumericUpDown x:Name="SizeInput" Value="{Binding Size,UpdateSourceTrigger=PropertyChanged}" Minimum="0.0001" Margin="0,4,0,10"/>
    <StackPanel>
     <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsChamfer}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
     <CheckBox x:Name="TwoDistancesCheck" Content="{Binding TwoDistancesLabel}" IsChecked="{Binding UseTwoDistances}" Margin="0,0,0,8"/>
     <StackPanel>
      <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding UseTwoDistances}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <TextBlock Text="{Binding SecondDistanceLabel}"/>
      <mah:NumericUpDown x:Name="SecondSizeInput" Value="{Binding SecondDistance,UpdateSourceTrigger=PropertyChanged}" Minimum="0.0001" Margin="0,4,0,10"/>
     </StackPanel>
    </StackPanel>
    <StackPanel>
     <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsFillet}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
     <CheckBox x:Name="VariableRadiusCheck" Content="{Binding VariableRadiusLabel}" IsChecked="{Binding UseEndRadius}" Margin="0,0,0,8"/>
     <StackPanel>
      <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding UseEndRadius}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <TextBlock Text="{Binding EndRadiusLabel}"/>
      <mah:NumericUpDown x:Name="EndRadiusInput" Value="{Binding EndRadius,UpdateSourceTrigger=PropertyChanged}" Minimum="0.0001" Margin="0,4,0,10"/>
     </StackPanel>
    </StackPanel>
   </StackPanel>
   <TextBlock Text="{Binding PrimaryEdgeLabel}" Margin="0,10,0,4"/>
   <TextBlock Text="{Binding SupportFaceLabel}" Margin="0,0,0,5">
    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding RequiresSupportFace}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
   </TextBlock>
   <CheckBox x:Name="AddEdgesOnPickCheck" Content="{Binding AddEdgesOnPickLabel}" IsChecked="{Binding AddEdgesOnPick}" IsEnabled="{Binding CanPickAdditionalEdges}" Margin="0,0,0,8">
    <CheckBox.Style><Style TargetType="CheckBox"><Style.Triggers><DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding IsChainedSource}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></CheckBox.Style>
   </CheckBox>
   <TextBlock Text="{Binding EdgeListLabel}" Margin="0,0,0,4"/>
   <ScrollViewer Height="124" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding CanPickAdditionalEdges}">
    <ItemsControl ItemsSource="{Binding EdgeChoices}"><ItemsControl.ItemTemplate><DataTemplate>
     <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected,Mode=TwoWay}" Margin="0,2">
      <CheckBox.Style><Style TargetType="CheckBox"><Style.Triggers><DataTrigger Binding="{Binding IsPrimary}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></CheckBox.Style>
     </CheckBox>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </ScrollViewer>
   <WrapPanel><Button Content="{I18N {x:Static r:LangKeys.Fit}}" Click="OnFit" Margin="0,0,8,0"/><Button Content="{I18N {x:Static r:LangKeys.Reselect}}" Command="{Binding ReselectCommand}"><Button.Style><Style TargetType="Button"><Style.Triggers><DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></WrapPanel>
   <StackPanel>
    <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
    <TextBlock Text="{I18N {x:Static r:LangKeys.SavedReferences}}" TextWrapping="Wrap" Margin="0,18,0,4"/>
    <ListBox ItemsSource="{Binding References}" SelectedItem="{Binding SelectedReference}" DisplayMemberPath="Label" Height="110" IsEnabled="{Binding CanEdit}"/>
    <WrapPanel Margin="0,8,0,0"><Button Content="{I18N {x:Static r:LangKeys.InspectReference}}" Command="{Binding InspectReferenceCommand}" Margin="0,0,6,6"/><Button Content="{I18N {x:Static r:LangKeys.SaveReference}}" Command="{Binding SaveReferenceCommand}" Margin="0,0,0,6"/></WrapPanel>
   </StackPanel>
  </StackPanel>
  <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,12" MinHeight="32"/>
  <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="{I18N {x:Static r:LangKeys.CalculatePreview}}" Command="{Binding PreviewCommand}" Margin="0,0,10,0"/>
   <Button Content="{I18N {x:Static r:LangKeys.Confirm}}" Command="{Binding ConfirmCommand}" Margin="0,0,10,0"/>
   <Button Content="{I18N {x:Static r:LangKeys.Cancel}}" Command="{Binding CancelCommand}"/>
  </StackPanel>
 </Grid>
</mah:MetroWindow>
