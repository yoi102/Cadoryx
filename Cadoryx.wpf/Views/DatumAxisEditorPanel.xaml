<UserControl x:Class="Cadoryx.wpf.Views.DatumAxisEditorPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" xmlns:r="clr-namespace:Cadoryx.Lang;assembly=Cadoryx.Lang">
 <Grid Margin="8">
  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="350"/></Grid.ColumnDefinitions>
  <DataGrid x:Name="AxisList" ItemsSource="{Binding Axes}" SelectedItem="{Binding SelectedAxis}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
   <DataGrid.Columns>
    <DataGridTextColumn Header="{I18N {x:Static r:LangKeys.Name}}" Binding="{Binding Name}" Width="*"/>
    <DataGridTextColumn Header="{I18N {x:Static r:LangKeys.DatumConstructionKind}}" Binding="{Binding Kind}" Width="190"/>
    <DataGridTextColumn Header="{I18N {x:Static r:LangKeys.DatumCoordinates}}" Binding="{Binding Frame}" Width="200"/>
    <DataGridTextColumn Header="{I18N {x:Static r:LangKeys.DatumState}}" Binding="{Binding State}" Width="100"/>
   </DataGrid.Columns>
  </DataGrid>
  <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
   <StackPanel>
    <Button Content="{I18N {x:Static r:LangKeys.New}}" Command="{Binding NewAxisCommand}" HorizontalAlignment="Left"/>
    <TextBlock Text="{I18N {x:Static r:LangKeys.Part}}" Margin="0,8,0,3"/>
    <ComboBox ItemsSource="{Binding Parts}" SelectedItem="{Binding Part}" DisplayMemberPath="Label"/>
    <TextBlock Text="{I18N {x:Static r:LangKeys.Name}}" Margin="0,8,0,3"/>
    <TextBox x:Name="AxisNameInput" Text="{Binding AxisName,UpdateSourceTrigger=PropertyChanged}"/>
    <ComboBox x:Name="AxisKindInput" ItemsSource="{Binding AxisKinds}" SelectedValue="{Binding AxisKind}" SelectedValuePath="Value" DisplayMemberPath="Label" Margin="0,8,0,0"/>
    <ComboBox ItemsSource="{Binding BasisAxes}" SelectedItem="{Binding BasisAxis}" IsEnabled="{Binding AxisNeedsBasis}" Margin="0,8,0,0"/>
    <TextBlock Text="{I18N {x:Static r:LangKeys.DatumFirstSource}}" Margin="0,8,0,3"/>
    <ComboBox ItemsSource="{Binding AxisFirstSources}" SelectedItem="{Binding AxisFirst}" DisplayMemberPath="Label" IsEnabled="{Binding AxisNeedsFirst}"/>
    <TextBlock Text="{I18N {x:Static r:LangKeys.DatumSecondSource}}" Margin="0,8,0,3"/>
    <ComboBox ItemsSource="{Binding AxisSecondSources}" SelectedItem="{Binding AxisSecond}" DisplayMemberPath="Label" IsEnabled="{Binding AxisNeedsSecond}"/>
    <TextBlock Text="{Binding AxisEvidence}" TextWrapping="Wrap" Margin="0,8,0,0"/>
    <TextBlock Text="{I18N {x:Static r:LangKeys.DatumCoordinates}}" Margin="0,8,0,3"/>
    <UniformGrid Columns="3" IsEnabled="{Binding AxisNeedsOrigin}">
     <mah:NumericUpDown Value="{Binding AxisX,UpdateSourceTrigger=PropertyChanged}" Minimum="-1000000" Maximum="1000000"/>
     <mah:NumericUpDown Value="{Binding AxisY,UpdateSourceTrigger=PropertyChanged}" Minimum="-1000000" Maximum="1000000"/>
     <mah:NumericUpDown Value="{Binding AxisZ,UpdateSourceTrigger=PropertyChanged}" Minimum="-1000000" Maximum="1000000"/>
    </UniformGrid>
    <TextBlock Text="{I18N {x:Static r:LangKeys.DatumDirection}}" Margin="0,8,0,3"/>
    <UniformGrid Columns="3" IsEnabled="{Binding AxisNeedsDirection}">
     <mah:NumericUpDown Value="{Binding AxisDx,UpdateSourceTrigger=PropertyChanged}" Minimum="-1000000" Maximum="1000000"/>
     <mah:NumericUpDown Value="{Binding AxisDy,UpdateSourceTrigger=PropertyChanged}" Minimum="-1000000" Maximum="1000000"/>
     <mah:NumericUpDown Value="{Binding AxisDz,UpdateSourceTrigger=PropertyChanged}" Minimum="-1000000" Maximum="1000000"/>
    </UniformGrid>
    <TextBlock Text="{I18N {x:Static r:LangKeys.DatumAxisOffset}}" Margin="0,8,0,3"/>
    <mah:NumericUpDown Value="{Binding AxisOffset,UpdateSourceTrigger=PropertyChanged}" Minimum="-1000000" Maximum="1000000"/>
    <CheckBox Content="{I18N {x:Static r:LangKeys.DatumReverse}}" IsChecked="{Binding AxisReverse}" Margin="0,8,0,4"/>
    <WrapPanel Margin="0,8,0,8">
     <Button x:Name="ApplyAxisButton" Content="{I18N {x:Static r:LangKeys.DatumApplyRecipe}}" Command="{Binding ApplyAxisCommand}" Margin="0,0,8,0"/>
     <Button Content="{I18N {x:Static r:LangKeys.Delete}}" Command="{Binding DeleteAxisCommand}"/>
    </WrapPanel>
    <Button Content="{I18N {x:Static r:LangKeys.DatumDetach}}" Command="{Binding DetachAxisCommand}"/>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</UserControl>
