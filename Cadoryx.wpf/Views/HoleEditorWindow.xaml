<mah:MetroWindow x:Class="Cadoryx.wpf.Views.HoleEditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
 xmlns:r="clr-namespace:Cadoryx.Lang;assembly=Cadoryx.Lang"
 Style="{StaticResource Cadoryx.DialogWindowStyle}" Title="{I18N {x:Static r:LangKeys.Hole}}"
 Width="820" Height="780" MinWidth="700" MinHeight="600" WindowStartupLocation="CenterOwner">
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="{I18N {x:Static r:LangKeys.HoleHint}}" TextWrapping="Wrap" Margin="0,0,0,12"/>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding CanEdit}">
   <StackPanel>
    <TextBlock Text="{I18N {x:Static r:LangKeys.HoleFeature}}"/>
    <ComboBox x:Name="FeaturePicker" ItemsSource="{Binding Features}" SelectedItem="{Binding SelectedFeature}" DisplayMemberPath="Label" Margin="0,4,0,10"/>
    <TextBlock Text="{I18N {x:Static r:LangKeys.HoleSource}}"/>
    <ComboBox x:Name="SourcePicker" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" DisplayMemberPath="Label" IsEnabled="{Binding CanChooseSource}" Margin="0,4,0,10"/>
    <TextBlock Text="{Binding SourceDescription}" Margin="0,0,0,6"/>
    <TextBlock Text="{I18N {x:Static r:LangKeys.Name}}"/>
    <TextBox x:Name="NameInput" Text="{Binding ObjectName,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsNew}" Margin="0,4,0,10"/>
    <TextBlock Text="{I18N {x:Static r:LangKeys.HoleHead}}"/>
    <ComboBox x:Name="HeadPicker" ItemsSource="{Binding Heads}" SelectedValuePath="Value" SelectedValue="{Binding Head}" DisplayMemberPath="Label" IsEnabled="{Binding CanSetHead}" Margin="0,4,0,10"/>
    <CheckBox x:Name="ThroughInput" Content="{I18N {x:Static r:LangKeys.HoleThrough}}" IsChecked="{Binding Through}" Margin="0,0,0,10"/>
    <CheckBox x:Name="StandardInput" Content="{I18N {x:Static r:LangKeys.HoleStandard}}" IsChecked="{Binding UseStandard}" IsEnabled="{Binding CanUseStandard}" Margin="0,0,0,6"/>
    <TextBlock Text="{I18N {x:Static r:LangKeys.HoleStandardHint}}" TextWrapping="Wrap" Margin="0,0,0,10"/>
    <UniformGrid Columns="2" IsEnabled="{Binding UseStandard}">
     <StackPanel Margin="0,0,12,10"><TextBlock Text="{I18N {x:Static r:LangKeys.HoleNominal}}"/><ComboBox x:Name="NominalPicker" ItemsSource="{Binding Nominals}" SelectedItem="{Binding Nominal}" Margin="0,4,0,0"/></StackPanel>
     <StackPanel Margin="0,0,0,10"><TextBlock Text="{I18N {x:Static r:LangKeys.HoleFit}}"/><ComboBox x:Name="FitPicker" ItemsSource="{Binding Fits}" SelectedValuePath="Value" SelectedValue="{Binding Fit}" DisplayMemberPath="Label" Margin="0,4,0,0"/></StackPanel>
    </UniformGrid>
    <CheckBox x:Name="ThreadInput" Content="{I18N {x:Static r:LangKeys.HoleThread}}" IsChecked="{Binding UseThread}" IsEnabled="{Binding CanUseThread}" Margin="0,0,0,6"/>
    <TextBlock Text="{I18N {x:Static r:LangKeys.HoleThreadRepresentation}}"/>
    <ComboBox x:Name="ThreadRepresentationPicker" ItemsSource="{Binding ThreadRepresentations}" SelectedValuePath="Value" SelectedValue="{Binding ThreadRepresentation}" DisplayMemberPath="Label" IsEnabled="{Binding UseThread}" Margin="0,4,0,10"/>
    <TextBlock Text="{Binding ThreadRepresentationHint}" TextWrapping="Wrap" Margin="0,0,0,10"/>
    <UniformGrid Columns="2" IsEnabled="{Binding UseThread}">
     <StackPanel Margin="0,0,12,10"><TextBlock Text="{I18N {x:Static r:LangKeys.HoleNominal}}"/><ComboBox x:Name="ThreadNominalPicker" ItemsSource="{Binding ThreadNominals}" SelectedItem="{Binding ThreadNominal}" Margin="0,4,0,0"/></StackPanel>
     <StackPanel Margin="0,0,0,10"><TextBlock Text="{I18N {x:Static r:LangKeys.HoleThreadHand}}"/><ComboBox x:Name="ThreadHandPicker" ItemsSource="{Binding ThreadHands}" SelectedValuePath="Value" SelectedValue="{Binding ThreadHand}" DisplayMemberPath="Label" Margin="0,4,0,0"/></StackPanel>
    </UniformGrid>
    <TextBlock Text="{Binding ThreadDescription}" Margin="0,0,0,6"/>
    <TextBlock Text="{I18N {x:Static r:LangKeys.HoleThreadDepth}}"/>
    <mah:NumericUpDown x:Name="ThreadDepthInput" Value="{Binding ThreadDepth}" Minimum="0.001" Maximum="1000000" IsEnabled="{Binding CanSetThreadDepth}" Margin="0,4,0,10"/>
    <UniformGrid Columns="2">
     <StackPanel Margin="0,0,12,10"><TextBlock Text="{I18N {x:Static r:LangKeys.HoleDiameter}}"/><mah:NumericUpDown x:Name="DiameterInput" Value="{Binding Diameter}" Minimum="0.001" Maximum="10000" IsEnabled="{Binding CanSetDiameter}" Margin="0,4,0,0"/></StackPanel>
     <StackPanel Margin="0,0,0,10"><TextBlock Text="{I18N {x:Static r:LangKeys.HoleDepth}}"/><mah:NumericUpDown x:Name="DepthInput" Value="{Binding Depth}" Minimum="0.001" Maximum="1000000" IsEnabled="{Binding IsBlind}" Margin="0,4,0,0"/></StackPanel>
     <StackPanel Margin="0,0,12,10"><TextBlock Text="{I18N {x:Static r:LangKeys.HoleHeadDiameter}}"/><mah:NumericUpDown x:Name="HeadDiameterInput" Value="{Binding HeadDiameter}" Minimum="0.001" Maximum="10000" IsEnabled="{Binding HasHead}" Margin="0,4,0,0"/></StackPanel>
     <StackPanel Margin="0,0,0,10"><TextBlock Text="{I18N {x:Static r:LangKeys.HoleHeadDepth}}"/><mah:NumericUpDown x:Name="HeadDepthInput" Value="{Binding HeadDepth}" Minimum="0.001" Maximum="1000000" IsEnabled="{Binding IsCounterbore}" Margin="0,4,0,0"/></StackPanel>
     <StackPanel Margin="0,0,12,10"><TextBlock Text="{I18N {x:Static r:LangKeys.HoleHeadAngle}}"/><mah:NumericUpDown x:Name="HeadAngleInput" Value="{Binding HeadAngle}" Minimum="60" Maximum="150" IsEnabled="{Binding IsCountersink}" Margin="0,4,0,0"/></StackPanel>
    </UniformGrid>
    <TextBlock Text="{I18N {x:Static r:LangKeys.HoleFrame}}"/>
    <ComboBox x:Name="DatumPicker" ItemsSource="{Binding Datums}" SelectedItem="{Binding SelectedDatum}" DisplayMemberPath="Label" Margin="0,4,0,12"/>
    <TextBlock Text="{I18N {x:Static r:LangKeys.HoleFrameHint}}" TextWrapping="Wrap" Margin="0,0,0,10"/>
    <UniformGrid Columns="2">
     <StackPanel Margin="0,0,12,10"><TextBlock Text="U (mm)"/><mah:NumericUpDown x:Name="UInput" Value="{Binding U}" Minimum="-1000000" Maximum="1000000"/></StackPanel>
     <StackPanel Margin="0,0,0,10"><TextBlock Text="V (mm)"/><mah:NumericUpDown x:Name="VInput" Value="{Binding V}" Minimum="-1000000" Maximum="1000000"/></StackPanel>
    </UniformGrid>
    <UniformGrid Columns="3" IsEnabled="{Binding CanSetFrame}">
     <StackPanel Margin="0,0,10,10"><TextBlock Text="X (mm)"/><mah:NumericUpDown x:Name="OriginXInput" Value="{Binding OriginX}" Minimum="-1000000" Maximum="1000000"/></StackPanel>
     <StackPanel Margin="0,0,10,10"><TextBlock Text="Y (mm)"/><mah:NumericUpDown Value="{Binding OriginY}" Minimum="-1000000" Maximum="1000000"/></StackPanel>
     <StackPanel Margin="0,0,0,10"><TextBlock Text="Z (mm)"/><mah:NumericUpDown x:Name="OriginZInput" Value="{Binding OriginZ}" Minimum="-1000000" Maximum="1000000"/></StackPanel>
     <StackPanel Margin="0,0,10,10"><TextBlock Text="Rx (°)"/><mah:NumericUpDown Value="{Binding RotationX}" Minimum="-3600" Maximum="3600"/></StackPanel>
     <StackPanel Margin="0,0,10,10"><TextBlock Text="Ry (°)"/><mah:NumericUpDown x:Name="RotationYInput" Value="{Binding RotationY}" Minimum="-3600" Maximum="3600"/></StackPanel>
     <StackPanel Margin="0,0,0,10"><TextBlock Text="Rz (°)"/><mah:NumericUpDown Value="{Binding RotationZ}" Minimum="-3600" Maximum="3600"/></StackPanel>
    </UniformGrid>
   </StackPanel>
  </ScrollViewer>
  <TextBlock Grid.Row="2" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,12"/>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
   <Button x:Name="PreviewButton" Content="{I18N {x:Static r:LangKeys.SolveAndPreview}}" Command="{Binding PreviewCommand}" Margin="0,0,8,0"/>
   <Button x:Name="ConfirmButton" Content="{I18N {x:Static r:LangKeys.Confirm}}" Command="{Binding ConfirmCommand}" Margin="0,0,8,0"/>
   <Button x:Name="CancelButton" Content="{I18N {x:Static r:LangKeys.Cancel}}" Command="{Binding CancelCommand}"/>
  </StackPanel>
 </Grid>
</mah:MetroWindow>
