<mah:MetroWindow x:Class="Cadoryx.wpf.Views.Settings.ApplicationSettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 Title="应用设置"
                 Width="760"
                 Height="560"
                 MinWidth="650"
                 MinHeight="480"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False"
                 Background="{DynamicResource MaterialDesign.Brush.Background}"
                 AutomationProperties.AutomationId="ApplicationSettingsWindow">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <local:ApplicationSettingsView xmlns:local="clr-namespace:Cadoryx.wpf.Views.Settings" />

        <TextBlock Grid.Row="1"
                   Text="{Binding ValidationError}"
                   Foreground="{DynamicResource MaterialDesign.Brush.Error}"
                   TextWrapping="Wrap"
                   Margin="4,8,4,0" />

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Button Content="恢复默认"
                    Click="Reset_Click"
                    MinWidth="88"
                    HorizontalAlignment="Left" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="确定"
                        Click="Ok_Click"
                        IsDefault="True"
                        MinWidth="88"
                        Margin="0,0,8,0" />
                <Button Content="应用"
                        Click="Apply_Click"
                        MinWidth="88"
                        Margin="0,0,8,0" />
                <Button Content="取消"
                        Click="Cancel_Click"
                        IsCancel="True"
                        MinWidth="88" />
            </StackPanel>
        </Grid>
    </Grid>
</mah:MetroWindow>
