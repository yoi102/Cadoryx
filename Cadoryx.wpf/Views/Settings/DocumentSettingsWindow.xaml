<mah:MetroWindow x:Class="Cadoryx.wpf.Views.Settings.DocumentSettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
 xmlns:cv="clr-namespace:Cadoryx.wpf.Converters"
 Style="{StaticResource Cadoryx.DialogWindowStyle}"
 Title="{Binding Labels.Title}"
 Width="940" Height="620" MinWidth="820" MinHeight="500"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 AutomationProperties.AutomationId="DocumentSettingsWindow">
 <Grid Margin="16">
  <Grid.Resources>
   <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
   <DataTemplate x:Key="DisplaySectionTemplate">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="0,0,8,0">
      <TextBlock Text="{Binding Labels.Display}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18"/>
      <TextBlock Text="{Binding Labels.Background}" Margin="0,0,0,8"/>
      <Border Height="105" Margin="0,0,0,18" CornerRadius="4"
              BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}" BorderThickness="1">
       <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
         <GradientStop Offset="0" Color="{Binding BackgroundTopArgb, Converter={x:Static cv:UIntColorToMediaColorConverter.Instance}}"/>
         <GradientStop Offset="1" Color="{Binding BackgroundBottomArgb, Converter={x:Static cv:UIntColorToMediaColorConverter.Instance}}"/>
        </LinearGradientBrush>
       </Border.Background>
      </Border>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock Grid.Row="0" Text="{Binding Labels.BackgroundTop}" VerticalAlignment="Center" Margin="0,0,16,12"/>
       <mah:ColorPicker Grid.Row="0" Grid.Column="1" x:Name="BackgroundTopPicker"
                        AutomationProperties.AutomationId="DocumentBackgroundTop"
                        MinWidth="190" Margin="0,0,0,12" HorizontalAlignment="Stretch"
                        IsAlphaChannelVisible="False" AddToRecentColorsTrigger="SelectedColorChanged"
                        SelectedColor="{Binding BackgroundTopArgb, Mode=TwoWay, Converter={x:Static cv:UIntColorToMediaColorConverter.Instance}}"/>
       <TextBlock Grid.Row="1" Text="{Binding Labels.BackgroundBottom}" VerticalAlignment="Center" Margin="0,0,16,0"/>
       <mah:ColorPicker Grid.Row="1" Grid.Column="1" x:Name="BackgroundBottomPicker"
                        AutomationProperties.AutomationId="DocumentBackgroundBottom"
                        MinWidth="190" HorizontalAlignment="Stretch"
                        IsAlphaChannelVisible="False" AddToRecentColorsTrigger="SelectedColorChanged"
                        SelectedColor="{Binding BackgroundBottomArgb, Mode=TwoWay, Converter={x:Static cv:UIntColorToMediaColorConverter.Instance}}"/>
      </Grid>
     </StackPanel>
    </ScrollViewer>
   </DataTemplate>
   <DataTemplate x:Key="GridSectionTemplate">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="0,0,8,0">
      <TextBlock Text="{Binding Labels.Grid}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18"/>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock Grid.Row="0" Text="{Binding Labels.GridVisible}" VerticalAlignment="Center" Margin="0,0,16,14"/>
       <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding GridVisible}" Margin="0,0,0,14"/>
       <TextBlock Grid.Row="1" Text="{Binding Labels.GridSpacing}" VerticalAlignment="Center" Margin="0,0,16,14"/>
       <mah:NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="GridSpacingInput"
                          AutomationProperties.AutomationId="DocumentGridSpacing"
                          Width="190" HorizontalAlignment="Left" Margin="0,0,0,14"
                          Minimum="0.1" Maximum="1000" Interval="1"
                          Value="{Binding GridSpacingMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
       <TextBlock Grid.Row="2" Text="{Binding Labels.GridSnap}" VerticalAlignment="Center" Margin="0,0,16,0"/>
       <CheckBox Grid.Row="2" Grid.Column="1" IsChecked="{Binding GridSnap}"/>
       <TextBlock Grid.Row="3" Text="{Binding Labels.WorkPlane}" VerticalAlignment="Center" Margin="0,14,16,14"/>
       <ComboBox Grid.Row="3" Grid.Column="1" Width="190" HorizontalAlignment="Left" Margin="0,14,0,14"
                 AutomationProperties.AutomationId="DocumentWorkPlane"
                 ItemsSource="{Binding WorkPlaneOptions}" SelectedItem="{Binding SelectedWorkPlane}" DisplayMemberPath="Label"/>
       <TextBlock Grid.Row="4" Text="{Binding Labels.WorkPlaneOffset}" VerticalAlignment="Center" Margin="0,0,16,0"/>
       <mah:NumericUpDown Grid.Row="4" Grid.Column="1" Width="190" HorizontalAlignment="Left"
                          AutomationProperties.AutomationId="DocumentWorkPlaneOffset"
                          Minimum="-1000000" Maximum="1000000" Interval="1"
                          Value="{Binding WorkPlaneOffsetMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
      </Grid>
      <StackPanel Margin="0,18,0,0" Visibility="{Binding IsCustomWorkPlane, Converter={StaticResource BoolVisibility}}">
       <TextBlock Text="{Binding Labels.WorkPlaneOrigin}" FontWeight="SemiBold" Margin="0,0,0,8"/>
       <WrapPanel>
        <TextBlock Text="X" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <mah:NumericUpDown Width="125" Minimum="-1000000" Maximum="1000000" Value="{Binding WorkPlaneOriginX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="WorkPlaneOriginX"/>
        <TextBlock Text="Y" VerticalAlignment="Center" Margin="16,0,8,0"/>
        <mah:NumericUpDown Width="125" Minimum="-1000000" Maximum="1000000" Value="{Binding WorkPlaneOriginY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="WorkPlaneOriginY"/>
        <TextBlock Text="Z" VerticalAlignment="Center" Margin="16,0,8,0"/>
        <mah:NumericUpDown Width="125" Minimum="-1000000" Maximum="1000000" Value="{Binding WorkPlaneOriginZ, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="WorkPlaneOriginZ"/>
       </WrapPanel>
       <TextBlock Text="{Binding Labels.WorkPlaneAngles}" FontWeight="SemiBold" Margin="0,18,0,8"/>
       <WrapPanel>
        <TextBlock Text="X" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <mah:NumericUpDown Width="125" Minimum="-3600" Maximum="3600" Value="{Binding WorkPlaneAngleX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="WorkPlaneAngleX"/>
        <TextBlock Text="Y" VerticalAlignment="Center" Margin="16,0,8,0"/>
        <mah:NumericUpDown Width="125" Minimum="-3600" Maximum="3600" Value="{Binding WorkPlaneAngleY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="WorkPlaneAngleY"/>
        <TextBlock Text="Z" VerticalAlignment="Center" Margin="16,0,8,0"/>
        <mah:NumericUpDown Width="125" Minimum="-3600" Maximum="3600" Value="{Binding WorkPlaneAngleZ, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="WorkPlaneAngleZ"/>
       </WrapPanel>
      </StackPanel>
     </StackPanel>
    </ScrollViewer>
   </DataTemplate>
   <DataTemplate x:Key="OriginSectionTemplate">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="0,0,8,0">
      <TextBlock Text="{Binding Labels.Origin}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18"/>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock Grid.Row="0" Text="{Binding Labels.OriginVisible}" VerticalAlignment="Center" Margin="0,0,16,14"/>
       <CheckBox Grid.Row="0" Grid.Column="1" AutomationProperties.AutomationId="DocumentOriginVisible"
                 IsChecked="{Binding OriginVisible}" Margin="0,0,0,14"/>
       <TextBlock Grid.Row="1" Text="{Binding Labels.OriginStyle}" VerticalAlignment="Center" Margin="0,0,16,14"/>
       <ComboBox Grid.Row="1" Grid.Column="1" Width="240" HorizontalAlignment="Left" Margin="0,0,0,14"
                 AutomationProperties.AutomationId="DocumentOriginStyle"
                 ItemsSource="{Binding OriginStyleOptions}" SelectedItem="{Binding SelectedOriginStyle}" DisplayMemberPath="Label"/>
       <TextBlock Grid.Row="2" Text="{Binding Labels.OriginSize}" VerticalAlignment="Center" Margin="0,0,16,0"/>
       <mah:NumericUpDown Grid.Row="2" Grid.Column="1" Width="190" HorizontalAlignment="Left"
                          AutomationProperties.AutomationId="DocumentOriginSize"
                          Minimum="1" Maximum="1000" Interval="1"
                          Value="{Binding OriginSizeMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
      </Grid>
      <TextBlock Text="{Binding Labels.OriginHint}" Margin="0,20,0,0" TextWrapping="Wrap"/>
     </StackPanel>
    </ScrollViewer>
   </DataTemplate>
   <DataTemplate x:Key="UnitsSectionTemplate">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="0,0,8,0">
      <TextBlock Text="{Binding Labels.Units}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18"/>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock Grid.Row="0" Text="{Binding Labels.DisplayUnit}" VerticalAlignment="Center" Margin="0,0,16,14"/>
       <ComboBox Grid.Row="0" Grid.Column="1" Width="190" HorizontalAlignment="Left" Margin="0,0,0,14"
                 ItemsSource="{Binding UnitOptions}" SelectedItem="{Binding SelectedUnit}" DisplayMemberPath="Label"/>
       <TextBlock Grid.Row="1" Text="{Binding Labels.DecimalPlaces}" VerticalAlignment="Center" Margin="0,0,16,0"/>
       <mah:NumericUpDown Grid.Row="1" Grid.Column="1" Width="190" HorizontalAlignment="Left"
                          Minimum="0" Maximum="12" Interval="1"
                          Value="{Binding DecimalPlaces, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
      </Grid>
     </StackPanel>
    </ScrollViewer>
   </DataTemplate>
  </Grid.Resources>
  <Grid.RowDefinitions>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <Grid Grid.Row="0">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="176"/>
    <ColumnDefinition Width="1"/>
    <ColumnDefinition Width="*"/>
   </Grid.ColumnDefinitions>
   <ListBox Grid.Column="0" x:Name="Sections"
            AutomationProperties.AutomationId="DocumentSettingsSections"
            Margin="0,0,12,0" Padding="0" BorderThickness="0" Background="Transparent"
            ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
            Style="{StaticResource MaterialDesignNavigationListBox}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    <ListBox.ItemTemplate>
     <DataTemplate>
      <StackPanel Orientation="Horizontal" Margin="5">
       <Border x:Name="SelectedBorder" Visibility="Hidden" Width="2" CornerRadius="2"
               Margin="2,0,5,0" Background="{DynamicResource MaterialDesign.Brush.Primary}"/>
       <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
      <DataTemplate.Triggers>
       <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
        <Setter TargetName="SelectedBorder" Property="Visibility" Value="Visible"/>
       </DataTrigger>
      </DataTemplate.Triggers>
     </DataTemplate>
    </ListBox.ItemTemplate>
   </ListBox>
   <Border Grid.Column="1" Background="{DynamicResource MaterialDesign.Brush.Divider}"/>
   <ContentControl Grid.Column="2" Margin="16,0,0,0"
                   HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                   Content="{Binding}">
    <ContentControl.Style>
     <Style TargetType="ContentControl">
      <Setter Property="ContentTemplate" Value="{StaticResource DisplaySectionTemplate}"/>
      <Style.Triggers>
       <DataTrigger Binding="{Binding SelectedSection.Id}" Value="Grid">
        <Setter Property="ContentTemplate" Value="{StaticResource GridSectionTemplate}"/>
       </DataTrigger>
       <DataTrigger Binding="{Binding SelectedSection.Id}" Value="Units">
        <Setter Property="ContentTemplate" Value="{StaticResource UnitsSectionTemplate}"/>
       </DataTrigger>
       <DataTrigger Binding="{Binding SelectedSection.Id}" Value="Origin">
        <Setter Property="ContentTemplate" Value="{StaticResource OriginSectionTemplate}"/>
       </DataTrigger>
      </Style.Triggers>
     </Style>
    </ContentControl.Style>
   </ContentControl>
  </Grid>
  <TextBlock Grid.Row="1" Text="{Binding ValidationError}" Margin="4,8,4,0"
             Foreground="{DynamicResource MaterialDesign.Brush.Error}" TextWrapping="Wrap"/>
  <Grid Grid.Row="2" Margin="0,14,0,0">
   <Button Content="{Binding Labels.Reset}" AutomationProperties.AutomationId="ResetDocumentSettingsButton"
           HorizontalAlignment="Left" MinWidth="88" Click="Reset_Click"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button Content="{Binding Labels.Ok}" AutomationProperties.AutomationId="DocumentSettingsOk"
            MinWidth="88" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"/>
    <Button Content="{Binding Labels.Apply}" AutomationProperties.AutomationId="DocumentSettingsApply"
            MinWidth="88" Margin="0,0,8,0" Click="Apply_Click"/>
    <Button Content="{Binding Labels.Cancel}" AutomationProperties.AutomationId="CancelDocumentSettingsButton"
            MinWidth="88" IsCancel="True" Click="Cancel_Click"/>
   </StackPanel>
  </Grid>
 </Grid>
</mah:MetroWindow>
