<UserControl x:Class="Cadoryx.wpf.Views.DocumentReviewView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" xmlns:r="clr-namespace:Cadoryx.Lang;assembly=Cadoryx.Lang">
 <StackPanel>
  <Expander Header="{I18N {x:Static r:LangKeys.ExactInspection}}" IsExpanded="True" Margin="0,0,0,12">
   <StackPanel Margin="8,8,8,10">
    <TextBlock Text="{I18N {x:Static r:LangKeys.ExactSelectionHint}}" TextWrapping="Wrap" Opacity="0.65"/>
    <WrapPanel Margin="0,8">
     <Button x:Name="MeasureButton" Content="{I18N {x:Static r:LangKeys.ExactMeasure}}" Command="{Binding MeasureCommand}"/>
     <Button Content="{I18N {x:Static r:LangKeys.Cancel}}" Command="{Binding CancelMeasurementCommand}" IsEnabled="{Binding IsMeasuring}" Margin="6,0"/>
    </WrapPanel>
    <TextBlock Text="{Binding MeasurementStatus}" TextWrapping="Wrap"/>
    <ItemsControl ItemsSource="{Binding Rows}">
     <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,4"><TextBlock Text="{Binding Name}" Opacity="0.6"/><TextBlock Text="{Binding Value}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </StackPanel>
  </Expander>
  <Expander Header="{I18N {x:Static r:LangKeys.InterferenceCheck}}" Margin="0,0,0,12">
   <StackPanel Margin="8,8,8,10">
    <TextBlock Text="{I18N {x:Static r:LangKeys.InterferenceHint}}" TextWrapping="Wrap" Opacity="0.65"/>
    <Button x:Name="CheckInterferenceButton" Content="{I18N {x:Static r:LangKeys.InterferenceCheck}}" Command="{Binding CheckInterferenceCommand}" Margin="0,8"/>
    <CheckBox Content="{I18N {x:Static r:LangKeys.BroadPhaseCheck}}" IsChecked="{Binding InterferenceBroadPhase}" Margin="0,4"/>
    <ListBox ItemsSource="{Binding InterferenceRows}" SelectedItem="{Binding SelectedInterference}" MaxHeight="220" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="2,4"><TextBlock Text="{Binding Label}" TextWrapping="Wrap"/><TextBlock Text="{Binding Details}" TextWrapping="Wrap" Opacity="0.7"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <Button Content="{I18N {x:Static r:LangKeys.LocateInterference}}" Command="{Binding LocateInterferenceCommand}" Margin="0,6"/>
   </StackPanel>
  </Expander>
  <Expander Header="{I18N {x:Static r:LangKeys.SectionView}}" Margin="0,0,0,12">
   <StackPanel Margin="8,8,8,10">
    <TextBlock Text="{I18N {x:Static r:LangKeys.SectionHint}}" TextWrapping="Wrap" Opacity="0.65"/>
    <CheckBox Content="{I18N {x:Static r:LangKeys.SectionEnabled}}" IsChecked="{Binding SectionEnabled}" Margin="0,8"/>
    <ComboBox ItemsSource="{Binding Axes}" SelectedItem="{Binding SectionAxis}"/>
    <TextBlock Text="{I18N {x:Static r:LangKeys.SectionOffset}}" Margin="0,8,0,3"/>
    <mah:NumericUpDown Value="{Binding SectionOffsetMm}" Minimum="-1000000000" Maximum="1000000000"/>
    <CheckBox Content="{I18N {x:Static r:LangKeys.SectionReverse}}" IsChecked="{Binding SectionReverse}" Margin="0,8"/>
    <CheckBox Content="{I18N {x:Static r:LangKeys.SectionSlab}}" IsChecked="{Binding SlabEnabled}" Margin="0,0,0,8"/>
    <TextBlock Text="{I18N {x:Static r:LangKeys.SectionThickness}}"/>
    <mah:NumericUpDown Value="{Binding SlabThicknessMm}" Minimum="0.001" Maximum="1000000000" IsEnabled="{Binding SlabEnabled}" Margin="0,3,0,8"/>
    <WrapPanel><Button x:Name="ApplySectionButton" Content="{I18N {x:Static r:LangKeys.SectionApply}}" Command="{Binding ApplySectionCommand}"/>
     <Button Content="{I18N {x:Static r:LangKeys.SectionReset}}" Command="{Binding ResetSectionCommand}" Margin="6,0"/></WrapPanel>
    <Expander Header="{I18N {x:Static r:LangKeys.CreateSection}}" Margin="0,10,0,0">
     <StackPanel Margin="8,8,8,10">
    <TextBlock Text="{I18N {x:Static r:LangKeys.SectionGeometryHint}}" TextWrapping="Wrap" Opacity="0.65"/>
    <TextBox Text="{Binding SectionName,UpdateSourceTrigger=PropertyChanged}" Margin="0,6"/>
    <CheckBox Content="{I18N {x:Static r:LangKeys.AssociativeSection}}" IsChecked="{Binding AssociativeSection}" Margin="0,4"/>
    <CheckBox Content="{I18N {x:Static r:LangKeys.SectionFaces}}" IsChecked="{Binding SectionFaces}" Margin="0,4"/>
    <Button x:Name="CreateSectionButton" Content="{I18N {x:Static r:LangKeys.CreateSection}}" Command="{Binding CreateSectionCommand}"/>
    <ListBox ItemsSource="{Binding AssociatedSectionRows}" SelectedItem="{Binding SelectedSection}" MaxHeight="160" Margin="0,8">
     <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" Opacity="0.65"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <WrapPanel><Button Content="{I18N {x:Static r:LangKeys.UpdateSection}}" Command="{Binding RefreshAssociatedSectionCommand}"/>
     <Button Content="{I18N {x:Static r:LangKeys.DetachSection}}" Command="{Binding DetachAssociatedSectionCommand}" Margin="6,0"/></WrapPanel>
     </StackPanel>
    </Expander>
   </StackPanel>
  </Expander>
  <Expander Header="{I18N {x:Static r:LangKeys.EngineeringDimension}}" Margin="0,0,0,12">
   <StackPanel Margin="8,8,8,10">
    <TextBlock Text="{I18N {x:Static r:LangKeys.DimensionHint}}" TextWrapping="Wrap" Opacity="0.65"/>
    <ListBox ItemsSource="{Binding DimensionRows}" SelectedItem="{Binding SelectedDimension}" DisplayMemberPath="Name" MaxHeight="160" Margin="0,8"/>
    <WrapPanel><Button Content="{I18N {x:Static r:LangKeys.NewDimension}}" Command="{Binding NewDimensionCommand}"/>
     <Button Content="{I18N {x:Static r:LangKeys.UseMeasuredDimension}}" Command="{Binding UseMeasuredDimensionCommand}" Margin="6,0"/></WrapPanel>
    <TextBox Text="{Binding DimensionName,UpdateSourceTrigger=PropertyChanged}" Margin="0,6"/>
    <CheckBox Content="{I18N {x:Static r:LangKeys.AngleDimension}}" IsChecked="{Binding AngleDimension}" Margin="0,4"/>
    <TextBlock Text="{I18N {x:Static r:LangKeys.DimensionPoints}}" TextWrapping="Wrap"/>
    <TextBox Text="{Binding DimensionFirst,UpdateSourceTrigger=PropertyChanged}" Margin="0,3"/>
    <TextBox Text="{Binding DimensionSecond,UpdateSourceTrigger=PropertyChanged}" Margin="0,3"/>
    <TextBox Text="{Binding DimensionThird,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding AngleDimension}" Margin="0,3"/>
    <TextBlock Text="{I18N {x:Static r:LangKeys.DimensionFlyout}}" Margin="0,6,0,3"/>
    <mah:NumericUpDown Value="{Binding DimensionFlyout}" Minimum="-1000000" Maximum="1000000"/>
    <WrapPanel Margin="0,8"><Button Content="{I18N {x:Static r:LangKeys.SaveDimension}}" Command="{Binding SaveDimensionCommand}"/>
     <Button Content="{I18N {x:Static r:LangKeys.ToggleDimension}}" Command="{Binding ToggleDimensionCommand}" Margin="6,0"/>
     <Button Content="{I18N {x:Static r:LangKeys.Delete}}" Command="{Binding DeleteDimensionCommand}"/></WrapPanel>
   </StackPanel>
  </Expander>
  <TextBlock Text="{Binding ReviewStatus}" TextWrapping="Wrap" Margin="0,4"/>
  <Expander Header="{I18N {x:Static r:LangKeys.ReviewBookmark}}" Margin="0,0,0,12">
   <StackPanel Margin="8,8,8,10">
    <TextBox Text="{Binding BookmarkName,UpdateSourceTrigger=PropertyChanged}"/>
    <Button Content="{I18N {x:Static r:LangKeys.SaveBookmark}}" Command="{Binding SaveBookmarkCommand}" Margin="0,6"/>
    <ListBox ItemsSource="{Binding BookmarkRows}" SelectedItem="{Binding SelectedBookmark}" DisplayMemberPath="Name" MaxHeight="160"/>
    <WrapPanel Margin="0,6"><Button Content="{I18N {x:Static r:LangKeys.RestoreBookmark}}" Command="{Binding RestoreBookmarkCommand}"/>
     <Button Content="{I18N {x:Static r:LangKeys.Delete}}" Command="{Binding DeleteBookmarkCommand}" Margin="6,0"/></WrapPanel>
   </StackPanel>
  </Expander>
  <Button Content="{I18N {x:Static r:LangKeys.Cancel}}" Command="{Binding CancelReviewOperationCommand}" IsEnabled="{Binding IsReviewBusy}"/>
 </StackPanel>
</UserControl>
