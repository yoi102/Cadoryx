<mah:MetroWindow x:Class="Cadoryx.wpf.Views.SketchRegionSourceSelectionWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" xmlns:r="clr-namespace:Cadoryx.Lang;assembly=Cadoryx.Lang"
 xmlns:controls="clr-namespace:Cadoryx.wpf.Controls" Style="{StaticResource Cadoryx.DialogWindowStyle}"
 Title="{I18N {x:Static r:LangKeys.RegionReselectSources}}" Width="1180" Height="740" MinWidth="940" MinHeight="600" WindowStartupLocation="CenterOwner">
 <Grid Margin="14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="{I18N {x:Static r:LangKeys.RegionReselectHint}}" TextWrapping="Wrap" Margin="0,0,0,12"/>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="520"/></Grid.ColumnDefinitions>
   <controls:SketchCanvas x:Name="Canvas" DataContext="{Binding PreviewEditor}" IsHitTestVisible="False"/>
   <DataGrid x:Name="SourceRows" Grid.Column="2" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" CanUserAddRows="False" IsEnabled="{Binding CanEdit}">
    <DataGrid.Columns>
     <DataGridTextColumn Header="{I18N {x:Static r:LangKeys.RegionReselectLoopHeader}}" Binding="{Binding LoopLabel}" Width="96" IsReadOnly="True"/>
     <DataGridTextColumn Header="{I18N {x:Static r:LangKeys.RegionReselectSlot}}" Binding="{Binding SlotNumber}" Width="64" IsReadOnly="True"/>
     <DataGridTextColumn Header="{I18N {x:Static r:LangKeys.RegionReselectSource}}" Binding="{Binding OriginalLabel}" Width="*" IsReadOnly="True"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding OriginalIdentity}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
     <DataGridTemplateColumn Header="{I18N {x:Static r:LangKeys.RegionReselectReplacement}}" Width="2*">
      <DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding Choices}" DisplayMemberPath="Label" SelectedItem="{Binding Replacement,UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Replacement.Identity}" Margin="2"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
     </DataGridTemplateColumn>
    </DataGrid.Columns>
   </DataGrid>
  </Grid>
  <TextBlock Grid.Row="2" Text="{Binding Status}" ToolTip="{Binding Details}" TextWrapping="Wrap" Margin="0,12"/>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
   <Button x:Name="FitButton" Content="{I18N {x:Static r:LangKeys.FitSketch}}" Click="OnFit" Margin="0,0,8,0"/>
   <Button x:Name="PreviewButton" Content="{I18N {x:Static r:LangKeys.SolveAndPreview}}" Command="{Binding PreviewCommand}" Margin="0,0,8,0"/>
   <Button x:Name="ApplyButton" Content="{I18N {x:Static r:LangKeys.ApplyValue}}" Command="{Binding ApplyCommand}" Margin="0,0,8,0"/>
   <Button x:Name="CancelButton" Content="{I18N {x:Static r:LangKeys.Cancel}}" Command="{Binding CancelCommand}"/>
  </StackPanel>
 </Grid>
</mah:MetroWindow>
