<mah:MetroWindow x:Class="Cadoryx.wpf.Views.FaceFeatureEditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
 xmlns:r="clr-namespace:Cadoryx.Lang;assembly=Cadoryx.Lang"
 Style="{StaticResource Cadoryx.DialogWindowStyle}" Title="{Binding Title}"
 Width="1220" Height="820" MinWidth="960" MinHeight="650" WindowStartupLocation="CenterOwner">
 <mah:MetroWindow.Resources>
  <Style x:Key="EditorButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Margin" Value="0,4,8,4"/></Style>
 </mah:MetroWindow.Resources>
 <Grid Margin="12">
  <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="400"/></Grid.ColumnDefinitions>
  <Border x:Name="ViewportContainer" Margin="0,0,14,0"/>
  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
   <StackPanel>
    <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" Margin="0,0,0,10"/>
    <TextBlock Text="{I18N {x:Static r:LangKeys.FaceSource}}"/>
    <ComboBox x:Name="SourcePicker" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" DisplayMemberPath="Label" IsEnabled="{Binding CanChooseSource}" Margin="0,4,0,10"/>
    <StackPanel IsEnabled="{Binding CanEdit}">
     <StackPanel>
      <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsOffset}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <TextBlock Text="{I18N {x:Static r:LangKeys.SolidOffsetDistance}}"/>
      <mah:NumericUpDown x:Name="OffsetDistanceInput" Value="{Binding OffsetDistance,UpdateSourceTrigger=PropertyChanged}" Minimum="-100000" Maximum="100000" StringFormat="0.######" Margin="0,4,0,10"/>
     </StackPanel>
     <StackPanel>
      <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsShell}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <TextBlock Text="{I18N {x:Static r:LangKeys.FaceThickness}}"/><mah:NumericUpDown x:Name="ThicknessInput" Value="{Binding Thickness,UpdateSourceTrigger=PropertyChanged}" Minimum="0.00001" Margin="0,4,0,8"/>
      <CheckBox x:Name="OutwardCheck" Content="{I18N {x:Static r:LangKeys.FaceOutward}}" IsChecked="{Binding Outward}" Margin="0,0,0,10"/>
     </StackPanel>
     <StackPanel>
      <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsPushPull}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <TextBlock Text="{I18N {x:Static r:LangKeys.FaceEditDistance}}"/>
      <mah:NumericUpDown x:Name="PushPullDistanceInput" Value="{Binding PushPullDistance,UpdateSourceTrigger=PropertyChanged}" Minimum="-100000" Maximum="100000" StringFormat="0.######" Margin="0,4,0,10"/>
      <TextBlock x:Name="PlanarNormalText" Text="{Binding PlanarNormalLabel}" TextWrapping="Wrap" Margin="0,0,0,10"/>
     </StackPanel>
     <StackPanel>
      <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding UsesFaceList}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <TextBlock Text="{Binding FaceListLabel}"/>
      <ListBox x:Name="ClosingFaceList" ItemsSource="{Binding ClosingFaces}" SelectedItem="{Binding SelectedClosingFace}" DisplayMemberPath="FullTopologyIndex" Height="130" Margin="0,4,0,8"/>
     </StackPanel>
     <StackPanel>
      <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsDraft}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <TextBlock Text="{I18N {x:Static r:LangKeys.FacePrograms}}"/>
      <ListBox x:Name="ProgramList" ItemsSource="{Binding Programs}" SelectedItem="{Binding SelectedProgram}" DisplayMemberPath="Label" Height="105" Margin="0,4,0,8"/>
      <Button x:Name="ReplaceFaceButton" Content="{I18N {x:Static r:LangKeys.FaceReplace}}" Command="{Binding ReplaceFaceCommand}" Style="{StaticResource EditorButton}"/>
      <StackPanel DataContext="{Binding SelectedProgram}">
       <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
       <TextBlock Text="{I18N {x:Static r:LangKeys.FaceAngle}}"/><mah:NumericUpDown x:Name="AngleInput" StringFormat="0.#####" Value="{Binding AngleDegrees,UpdateSourceTrigger=PropertyChanged}" Minimum="-89.99" Maximum="89.99" Margin="0,4,0,8"/>
       <TextBlock Text="{I18N {x:Static r:LangKeys.FacePull}}"/>
       <UniformGrid Columns="3" Margin="0,4,0,8"><mah:NumericUpDown x:Name="PullXInput" Value="{Binding PullX,UpdateSourceTrigger=PropertyChanged}"/><mah:NumericUpDown x:Name="PullYInput" Value="{Binding PullY,UpdateSourceTrigger=PropertyChanged}"/><mah:NumericUpDown x:Name="PullZInput" Value="{Binding PullZ,UpdateSourceTrigger=PropertyChanged}"/></UniformGrid>
       <TextBlock Text="{I18N {x:Static r:LangKeys.FacePropagation}}"/>
       <ComboBox x:Name="PropagationPicker" ItemsSource="{Binding DataContext.Propagations,RelativeSource={RelativeSource AncestorType=mah:MetroWindow}}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Propagation}" Margin="0,4,0,8"/>
       <TextBlock Text="{I18N {x:Static r:LangKeys.FaceNeutral}}" TextWrapping="Wrap"/>
       <StackPanel IsEnabled="{Binding CanSetNeutral}">
        <UniformGrid Columns="3" Margin="0,4,0,4"><mah:NumericUpDown x:Name="NeutralXInput" Value="{Binding Neutral.X,UpdateSourceTrigger=PropertyChanged}"/><mah:NumericUpDown x:Name="NeutralYInput" Value="{Binding Neutral.Y,UpdateSourceTrigger=PropertyChanged}"/><mah:NumericUpDown x:Name="NeutralZInput" Value="{Binding Neutral.Z,UpdateSourceTrigger=PropertyChanged}"/></UniformGrid>
        <UniformGrid Columns="3" Margin="0,0,0,8"><mah:NumericUpDown x:Name="NeutralRxInput" Value="{Binding Neutral.Rx,UpdateSourceTrigger=PropertyChanged}"/><mah:NumericUpDown x:Name="NeutralRyInput" Value="{Binding Neutral.Ry,UpdateSourceTrigger=PropertyChanged}"/><mah:NumericUpDown x:Name="NeutralRzInput" Value="{Binding Neutral.Rz,UpdateSourceTrigger=PropertyChanged}"/></UniformGrid>
       </StackPanel>
      </StackPanel>
      <TextBlock Text="{Binding NeutralDatumLabel}" Margin="0,4,0,0"/>
      <ComboBox x:Name="DatumPicker" ItemsSource="{Binding Datums}" SelectedItem="{Binding SelectedDatum}" DisplayMemberPath="Label" Margin="0,4,0,4"/>
      <WrapPanel><Button x:Name="LinkDatumButton" Content="{I18N {x:Static r:LangKeys.FaceLinkDatum}}" Command="{Binding LinkDatumCommand}" Style="{StaticResource EditorButton}"/><Button x:Name="DetachDatumButton" Content="{I18N {x:Static r:LangKeys.FaceDetachDatum}}" Command="{Binding DetachDatumCommand}" Style="{StaticResource EditorButton}"/></WrapPanel>
     </StackPanel>
     <WrapPanel>
      <WrapPanel>
       <WrapPanel.Style><Style TargetType="WrapPanel"><Style.Triggers><DataTrigger Binding="{Binding UsesFaces}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></WrapPanel.Style>
       <Button x:Name="RemoveFaceButton" Content="{I18N {x:Static r:LangKeys.Delete}}" Command="{Binding RemoveFaceCommand}" Style="{StaticResource EditorButton}"/><Button x:Name="ClearFacesButton" Content="{I18N {x:Static r:LangKeys.FaceClear}}" Command="{Binding ClearFacesCommand}" Style="{StaticResource EditorButton}"/>
      </WrapPanel>
      <Button Content="{I18N {x:Static r:LangKeys.Fit}}" Click="OnFit" Style="{StaticResource EditorButton}"/>
     </WrapPanel>
    </StackPanel>
   </StackPanel>
  </ScrollViewer>
  <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,10,0,8"/>
  <WrapPanel Grid.Row="2" Grid.ColumnSpan="2" HorizontalAlignment="Right"><Button x:Name="PreviewButton" Content="{I18N {x:Static r:LangKeys.SolveAndPreview}}" Command="{Binding PreviewCommand}" Style="{StaticResource EditorButton}"/><Button x:Name="ConfirmButton" Content="{I18N {x:Static r:LangKeys.Confirm}}" Command="{Binding ConfirmCommand}" Style="{StaticResource EditorButton}"/><Button x:Name="CancelButton" Content="{I18N {x:Static r:LangKeys.Cancel}}" Command="{Binding CancelCommand}" Style="{StaticResource EditorButton}"/></WrapPanel>
 </Grid>
</mah:MetroWindow>
