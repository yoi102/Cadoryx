<mah:MetroWindow x:Class="Cadoryx.wpf.Views.ParameterEditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
 xmlns:r="clr-namespace:Cadoryx.Lang;assembly=Cadoryx.Lang"
 Style="{StaticResource Cadoryx.DialogWindowStyle}" Title="{I18N {x:Static r:LangKeys.DocumentParameters}}"
 Width="1120" Height="790" MinWidth="900" MinHeight="650" WindowStartupLocation="CenterOwner">
 <Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="{I18N {x:Static r:LangKeys.ParameterSyntaxHint}}" TextWrapping="Wrap" Margin="0,0,0,12"/>
  <Grid Grid.Row="1" IsEnabled="{Binding CanEdit}">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="370"/></Grid.ColumnDefinitions>
   <Grid>
    <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="160"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DataGrid x:Name="ParameterList" ItemsSource="{Binding Parameters}" SelectedItem="{Binding SelectedParameter}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
     <DataGrid.Columns>
      <DataGridTextColumn Header="{I18N {x:Static r:LangKeys.Name}}" Binding="{Binding Name}" Width="*"/>
      <DataGridTextColumn Header="{I18N {x:Static r:LangKeys.ParameterDimension}}" Binding="{Binding Dimension}" Width="110"/>
      <DataGridTextColumn Header="{I18N {x:Static r:LangKeys.ParameterExpression}}" Binding="{Binding Expression}" Width="*"/>
      <DataGridTextColumn Header="{I18N {x:Static r:LangKeys.ParameterValue}}" Binding="{Binding Value}" Width="*"/>
     </DataGrid.Columns>
    </DataGrid>
    <TextBlock Grid.Row="1" Text="{I18N {x:Static r:LangKeys.ParameterBind}}" Margin="0,12,0,6"/>
    <ListBox Grid.Row="2" ItemsSource="{Binding Bindings}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedBinding}"/>
    <Button Grid.Row="3" Content="{I18N {x:Static r:LangKeys.ParameterDetach}}" Command="{Binding DetachBindingCommand}" Margin="0,8,0,0" HorizontalAlignment="Left"/>
   </Grid>
   <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
    <StackPanel>
     <Button x:Name="NewParameterButton" Content="{I18N {x:Static r:LangKeys.ParameterNew}}" Command="{Binding NewParameterCommand}" HorizontalAlignment="Left" Margin="0,0,0,10"/>
     <TextBlock Text="{I18N {x:Static r:LangKeys.Name}}"/>
     <TextBox x:Name="ParameterNameInput" Text="{Binding ParameterName,UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
     <TextBlock Text="{I18N {x:Static r:LangKeys.ParameterDimension}}"/>
     <ComboBox x:Name="DimensionPicker" ItemsSource="{Binding Dimensions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Dimension}" Margin="0,4,0,10"/>
     <CheckBox x:Name="ReferenceMode" Content="{I18N {x:Static r:LangKeys.ParameterReferenceMode}}" IsChecked="{Binding IsReference}" Margin="0,4,0,10"/>
     <ComboBox x:Name="ReferencePicker" ItemsSource="{Binding Targets}" DisplayMemberPath="Label" SelectedItem="{Binding ReferenceTarget}" ToolTip="{Binding ReferenceTarget.Label}" IsEnabled="{Binding IsReference}" Margin="0,0,0,10">
      <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem"><Setter Property="ToolTip" Value="{Binding Label}"/></Style></ComboBox.ItemContainerStyle>
     </ComboBox>
     <TextBlock Text="{I18N {x:Static r:LangKeys.ParameterExpression}}"/>
     <TextBox x:Name="ExpressionInput" Text="{Binding Expression,UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10">
      <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Style.Triggers><DataTrigger Binding="{Binding IsReference}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></TextBox.Style>
     </TextBox>
     <WrapPanel>
      <Button x:Name="ApplyParameterButton" Content="{I18N {x:Static r:LangKeys.ParameterApply}}" Command="{Binding ApplyParameterCommand}" Margin="0,0,8,8"/>
      <Button Content="{I18N {x:Static r:LangKeys.ParameterDelete}}" Command="{Binding DeleteParameterCommand}" Margin="0,0,0,8"/>
     </WrapPanel>
     <Separator Margin="0,12"/>
     <TextBlock Text="{I18N {x:Static r:LangKeys.ParameterBind}}"/>
     <ComboBox x:Name="DrivingPicker" ItemsSource="{Binding Targets}" DisplayMemberPath="Label" SelectedItem="{Binding DrivingTarget}" ToolTip="{Binding DrivingTarget.Label}" Margin="0,6,0,10">
      <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem"><Setter Property="ToolTip" Value="{Binding Label}"/></Style></ComboBox.ItemContainerStyle>
     </ComboBox>
     <Button x:Name="BindDimensionButton" Content="{I18N {x:Static r:LangKeys.ParameterBind}}" Command="{Binding BindDimensionCommand}" HorizontalAlignment="Left"/>
    </StackPanel>
   </ScrollViewer>
  </Grid>
  <TextBlock Grid.Row="2" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,12"/>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
   <Button x:Name="PreviewButton" Content="{I18N {x:Static r:LangKeys.SolveAndPreview}}" Command="{Binding PreviewCommand}" Margin="0,0,8,0"/>
   <Button x:Name="ConfirmButton" Content="{I18N {x:Static r:LangKeys.Confirm}}" Command="{Binding ConfirmCommand}" Margin="0,0,8,0"/>
   <Button Content="{I18N {x:Static r:LangKeys.Cancel}}" Command="{Binding CancelCommand}"/>
  </StackPanel>
 </Grid>
</mah:MetroWindow>
