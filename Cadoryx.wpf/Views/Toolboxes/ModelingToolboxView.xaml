<UserControl x:Class="Cadoryx.wpf.Views.Toolboxes.ModelingToolboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:r="clr-namespace:Cadoryx.Lang;assembly=Cadoryx.Lang">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <TextBlock Text="{I18N {x:Static r:LangKeys.ModelingParameters}}"
                       FontSize="18"
                       Margin="0,0,0,10" />

            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Document}" Value="{x:Null}">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <ComboBox SelectedValue="{Binding Document.ToolKind}"
                          SelectedValuePath="Tag"
                          Margin="0,0,0,8">
                    <ComboBoxItem Content="{I18N {x:Static r:LangKeys.Box}}" Tag="Box" />
                    <ComboBoxItem Content="{I18N {x:Static r:LangKeys.Cylinder}}" Tag="Cylinder" />
                    <ComboBoxItem Content="{I18N {x:Static r:LangKeys.PolygonExtrude}}" Tag="Extrude" />
                    <ComboBoxItem Content="{I18N {x:Static r:LangKeys.PolygonRevolve}}" Tag="Revolve" />
                </ComboBox>

                <TextBlock Text="{I18N {x:Static r:LangKeys.Name}}" />
                <TextBox Text="{Binding Document.ObjectName, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,2,0,8" />

                <TextBlock Text="{I18N {x:Static r:LangKeys.SizeXRadius}}" />
                <mah:NumericUpDown Value="{Binding Document.SizeX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   Minimum="0.001"
                                   Margin="0,2,0,8" />

                <TextBlock Text="{I18N {x:Static r:LangKeys.SizeY}}" />
                <mah:NumericUpDown Value="{Binding Document.SizeY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   Minimum="0.001"
                                   Margin="0,2,0,8" />

                <TextBlock Text="{I18N {x:Static r:LangKeys.SizeZDistance}}" />
                <mah:NumericUpDown Value="{Binding Document.SizeZ, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   Minimum="0.001"
                                   Margin="0,2,0,8" />

                <TextBlock Text="{I18N {x:Static r:LangKeys.PositionXYZ}}" />
                <UniformGrid Columns="3" Margin="0,2,0,8">
                    <mah:NumericUpDown Value="{Binding Document.PositionX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       HideUpDownButtons="True" />
                    <mah:NumericUpDown Value="{Binding Document.PositionY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       HideUpDownButtons="True" />
                    <mah:NumericUpDown Value="{Binding Document.PositionZ, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       HideUpDownButtons="True" />
                </UniformGrid>

                <TextBlock Text="{I18N {x:Static r:LangKeys.RotationAngle}}" />
                <mah:NumericUpDown Value="{Binding Document.AngleDegrees, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   Minimum="0.01"
                                   Maximum="360"
                                   Margin="0,2,0,8" />

                <Expander Header="{I18N {x:Static r:LangKeys.ExtrudeRevolveProfile}}"
                          Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="{I18N {x:Static r:LangKeys.ProfileInstruction}}"
                                   TextWrapping="Wrap"
                                   Margin="0,6" />
                        <DataGrid ItemsSource="{Binding Document.ProfilePoints}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  Height="140">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{I18N {x:Static r:LangKeys.AxisX}}"
                                                    Binding="{Binding X, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="*" />
                                <DataGridTextColumn Header="{I18N {x:Static r:LangKeys.AxisY}}"
                                                    Binding="{Binding Y, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <WrapPanel>
                            <Button Content="{I18N {x:Static r:LangKeys.AddPoint}}"
                                    Command="{Binding Document.AddProfilePointCommand}" />
                            <Button Content="{I18N {x:Static r:LangKeys.RemovePoint}}"
                                    Command="{Binding Document.RemoveProfilePointCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </Expander>

                <Button Content="{I18N {x:Static r:LangKeys.CalculatePreview}}"
                        Command="{Binding Document.PreviewCommand}"
                        Margin="0,4" />
                <UniformGrid Columns="2">
                    <Button Content="{I18N {x:Static r:LangKeys.Confirm}}"
                            Command="{Binding Document.ConfirmCommand}"
                            IsEnabled="{Binding Document.HasPreview}"
                            Margin="0,4,4,4" />
                    <Button Content="{I18N {x:Static r:LangKeys.Cancel}}"
                            Command="{Binding Document.CancelCommand}"
                            Margin="4,4,0,4" />
                </UniformGrid>

                <TextBlock Text="{I18N {x:Static r:LangKeys.BooleanInstruction}}"
                           TextWrapping="Wrap"
                           Margin="0,10,0,6" />
                <UniformGrid Columns="3">
                    <Button Content="{I18N {x:Static r:LangKeys.Union}}"
                            Command="{Binding Document.BooleanPreviewCommand}"
                            CommandParameter="Fuse"
                            Padding="4" />
                    <Button Content="{I18N {x:Static r:LangKeys.Difference}}"
                            Command="{Binding Document.BooleanPreviewCommand}"
                            CommandParameter="Cut"
                            Padding="4" />
                    <Button Content="{I18N {x:Static r:LangKeys.Intersection}}"
                            Command="{Binding Document.BooleanPreviewCommand}"
                            CommandParameter="Common"
                            Padding="4" />
                </UniformGrid>

                <TextBlock Text="{Binding Document.ToolStatus}"
                           TextWrapping="Wrap"
                           Margin="0,12" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
