<UserControl x:Class="Cadoryx.wpf.Views.Toolboxes.ModelingToolboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:r="clr-namespace:Cadoryx.Lang;assembly=Cadoryx.Lang"
             xmlns:vm="clr-namespace:Cadoryx.ViewModels.Toolboxes;assembly=Cadoryx.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ModelingToolboxViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <TextBlock Text="{I18N {x:Static r:LangKeys.ModelingParameters}}"
                       FontSize="18"
                       Margin="0,0,0,10" />

            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Document}" Value="{x:Null}">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Expander Header="{I18N {x:Static r:LangKeys.CreationTarget}}" Margin="0,0,0,12">
                    <StackPanel IsEnabled="{Binding Document.IsCreating}" Margin="8,8,8,10">
                        <TextBlock Text="{I18N {x:Static r:LangKeys.TargetPart}}"/>
                        <ComboBox ItemsSource="{Binding Document.TargetParts}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Document.SelectedTargetPart,Mode=TwoWay}" Margin="0,4,0,8"/>
                        <TextBlock Text="{Binding Document.TargetPartHint}" TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,8"/>
                        <TextBlock Text="{I18N {x:Static r:LangKeys.Layer}}"/>
                        <ComboBox ItemsSource="{Binding Document.CreationLayers}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Document.SelectedCreationLayer,Mode=TwoWay}" Margin="0,4,0,8"/>
                        <TextBlock Text="{I18N {x:Static r:LangKeys.Material}}"/>
                        <ComboBox ItemsSource="{Binding Document.CreationMaterials}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Document.SelectedCreationMaterial,Mode=TwoWay}" Margin="0,4,0,8"/>
                        <Button Content="{I18N {x:Static r:LangKeys.NoMaterial}}" Command="{Binding Document.ClearCreationMaterialCommand}"/>
                    </StackPanel>
                </Expander>
                <ComboBox x:Name="ModelingToolInput" SelectedValue="{Binding Document.ToolKind}"
                          SelectedValuePath="Tag"
                          Margin="0,0,0,8">
                    <ComboBoxItem Content="{I18N {x:Static r:LangKeys.Box}}" Tag="Box" />
                    <ComboBoxItem Content="{I18N {x:Static r:LangKeys.Cylinder}}" Tag="Cylinder" />
                    <ComboBoxItem Content="{I18N {x:Static r:LangKeys.PolygonExtrude}}" Tag="Extrude" />
                    <ComboBoxItem Content="{I18N {x:Static r:LangKeys.PolygonRevolve}}" Tag="Revolve" />
                </ComboBox>

                <Button Content="{Binding Document.ViewportDrawingLabel}" Command="{Binding Document.BeginViewportConstructionCommand}" Margin="0,0,0,8" />
                <TextBlock Text="{Binding Document.ViewportDrawingHint}" TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,8" />

                <StackPanel>
                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Document.IsProfileTool}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <StackPanel IsEnabled="{Binding Document.IsCreating}">
                        <CheckBox Content="{I18N {x:Static r:LangKeys.AssociateSketch}}" IsChecked="{Binding Document.UseLinkedSketch}" IsEnabled="{Binding Document.CanChangeSketchAssociation}" Margin="0,0,0,6"/>
                        <TextBlock Text="{I18N {x:Static r:LangKeys.SourceSketchLoop}}"/>
                        <ComboBox x:Name="SketchProfileInput" ItemsSource="{Binding Document.SketchProfiles}" SelectedItem="{Binding Document.SelectedSketchProfile}" DisplayMemberPath="Label" IsEnabled="{Binding Document.CanChooseSketchProfile}" Margin="0,4,0,8"/>
                        <Expander x:Name="ProfileRegionsExpander" Header="{I18N {x:Static r:LangKeys.ProfileRegions}}" IsEnabled="{Binding Document.CanChooseSketchHoles}" Margin="0,0,0,10">
                         <StackPanel Margin="8,8,8,10">
                            <Button x:Name="AutoNestRegionsButton" Content="{I18N {x:Static r:LangKeys.AutoNestRegions}}"
                                    Command="{Binding Document.AutoNestSketchRegionsCommand}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding Document.AutoNestStatus}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <TextBlock Text="{I18N {x:Static r:LangKeys.SketchCircularHoles}}" Margin="0,0,0,4"/>
                            <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Document.SketchHoleChoices}">
                                    <ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected,Mode=TwoWay}" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Text="{I18N {x:Static r:LangKeys.SketchPolygonHoles}}" Margin="0,8,0,4"/>
                            <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Document.SketchPolygonHoleChoices}">
                                    <ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected,Mode=TwoWay}" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Text="{I18N {x:Static r:LangKeys.MixedCurveLoop}}" Margin="0,8,0,4"/>
                            <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Document.SketchMixedHoleChoices}">
                                    <ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected,Mode=TwoWay}" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Text="{I18N {x:Static r:LangKeys.SplineHoles}}" Margin="0,8,0,4"/>
                            <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Document.SketchSplineHoleChoices}">
                                    <ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected,Mode=TwoWay}" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Text="{I18N {x:Static r:LangKeys.SketchIslands}}" Margin="0,8,0,4"/>
                            <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding Document.SketchIslandCircleChoices}">
                                        <ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected,Mode=TwoWay}" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding Document.SketchIslandPolygonChoices}">
                                        <ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected,Mode=TwoWay}" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding Document.SketchIslandMixedChoices}">
                                        <ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected,Mode=TwoWay}" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                         </StackPanel>
                        </Expander>
                    </StackPanel>
                    <TextBlock Text="{Binding Document.ProfileInputHint}" TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,8"/>
                </StackPanel>
                <TextBlock Text="{I18N {x:Static r:LangKeys.Name}}" />
                <TextBox x:Name="ModelingNameInput" Text="{Binding Document.ObjectName, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,2,0,8" />

                <TextBlock Text="{I18N {x:Static r:LangKeys.SizeXRadius}}" />
                <mah:NumericUpDown x:Name="ModelingSizeXInput" Value="{Binding Document.SizeX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   Minimum="0.001"
                                   Margin="0,2,0,8" />

                <TextBlock Text="{I18N {x:Static r:LangKeys.SizeY}}" />
                <mah:NumericUpDown Value="{Binding Document.SizeY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   Minimum="0.001"
                                   Margin="0,2,0,8" />

                <TextBlock Text="{I18N {x:Static r:LangKeys.SizeZDistance}}" />
                <mah:NumericUpDown x:Name="ModelingSizeZInput" Value="{Binding Document.SizeZ, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   Minimum="0.001"
                                   Margin="0,2,0,8" />

                <TextBlock Text="{I18N {x:Static r:LangKeys.PositionXYZ}}" />
                <UniformGrid Columns="3" Margin="0,2,0,8" IsEnabled="{Binding Document.IsFrozenProfile}">
                    <mah:NumericUpDown x:Name="ModelingPositionXInput" Value="{Binding Document.PositionX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       HideUpDownButtons="True" />
                    <mah:NumericUpDown Value="{Binding Document.PositionY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       HideUpDownButtons="True" />
                    <mah:NumericUpDown Value="{Binding Document.PositionZ, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       HideUpDownButtons="True" />
                </UniformGrid>

                <StackPanel Margin="0,2,0,8">
                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><DataTrigger Binding="{Binding Document.IsRevolveTool}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                    </Style></StackPanel.Style>
                    <TextBlock Text="{I18N {x:Static r:LangKeys.RevolveAxis}}" />
                    <ComboBox x:Name="RevolveAxisInput" ItemsSource="{Binding Document.RevolveAxes}" SelectedItem="{Binding Document.SelectedRevolveAxis}" DisplayMemberPath="Label" Margin="0,2,0,4" />
                    <TextBlock Text="{I18N {x:Static r:LangKeys.RevolveAxisHint}}" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <WrapPanel>
                        <Button x:Name="UseLocalRevolveAxisButton" Content="{I18N {x:Static r:LangKeys.RevolveLocalAxis}}" Command="{Binding Document.UseLocalRevolveAxisCommand}" Margin="0,0,4,0" />
                        <Button x:Name="DetachRevolveAxisButton" Content="{I18N {x:Static r:LangKeys.DatumDetach}}" Command="{Binding Document.DetachRevolveAxisCommand}" IsEnabled="{Binding Document.CanDetachRevolveAxis}" />
                    </WrapPanel>
                </StackPanel>
                <TextBlock Text="{I18N {x:Static r:LangKeys.RotationAngle}}" />
                <mah:NumericUpDown x:Name="RevolveAngleInput" Value="{Binding Document.AngleDegrees, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   Minimum="0.01"
                                   Maximum="360"
                                   Margin="0,2,0,8" />

                <Expander IsEnabled="{Binding Document.CanEditProfilePoints}" Header="{I18N {x:Static r:LangKeys.ExtrudeRevolveProfile}}"
                          Margin="0,0,0,8">
                    <StackPanel Margin="8,8,8,10">
                        <TextBlock Text="{I18N {x:Static r:LangKeys.ProfileInstruction}}"
                                   TextWrapping="Wrap"
                                   Margin="0,6" />
                        <DataGrid ItemsSource="{Binding Document.ProfilePoints}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  Height="140">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{I18N {x:Static r:LangKeys.AxisX}}"
                                                    Binding="{Binding X, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="*" />
                                <DataGridTextColumn Header="{I18N {x:Static r:LangKeys.AxisY}}"
                                                    Binding="{Binding Y, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <WrapPanel>
                            <Button Content="{I18N {x:Static r:LangKeys.AddPoint}}"
                                    Command="{Binding Document.AddProfilePointCommand}" />
                            <Button Content="{I18N {x:Static r:LangKeys.RemovePoint}}"
                                    Command="{Binding Document.RemoveProfilePointCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </Expander>

                <Button x:Name="ModelingPreviewButton" Content="{I18N {x:Static r:LangKeys.CalculatePreview}}"
                        Command="{Binding Document.PreviewCommand}"
                        Margin="0,4" />
                <UniformGrid Columns="2">
                    <Button x:Name="ModelingConfirmButton" Content="{I18N {x:Static r:LangKeys.Confirm}}"
                            Command="{Binding Document.ConfirmCommand}"
                            IsEnabled="{Binding Document.HasPreview}"
                            Margin="0,4,4,4" />
                    <Button x:Name="ModelingCancelButton" Content="{I18N {x:Static r:LangKeys.Cancel}}"
                            Command="{Binding Document.CancelCommand}"
                            Margin="4,4,0,4" />
                </UniformGrid>

                <Expander Header="{I18N {x:Static r:LangKeys.BooleanOperations}}" Margin="0,10,0,8">
                 <StackPanel Margin="8,8,8,10">
                <TextBlock Text="{I18N {x:Static r:LangKeys.BooleanInstruction}}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10" />
                <UniformGrid Columns="3">
                    <Button Content="{I18N {x:Static r:LangKeys.Union}}"
                            Command="{Binding Document.BooleanPreviewCommand}"
                            CommandParameter="Fuse"
                            Padding="4" />
                    <Button Content="{I18N {x:Static r:LangKeys.Difference}}"
                            Command="{Binding Document.BooleanPreviewCommand}"
                            CommandParameter="Cut"
                            Padding="4" />
                    <Button Content="{I18N {x:Static r:LangKeys.Intersection}}"
                            Command="{Binding Document.BooleanPreviewCommand}"
                            CommandParameter="Common"
                            Padding="4" />
                </UniformGrid>
                 </StackPanel>
                </Expander>

                <TextBlock x:Name="ModelingStatusText" Text="{Binding Document.ToolStatus}"
                           TextWrapping="Wrap"
                           Margin="0,12" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
