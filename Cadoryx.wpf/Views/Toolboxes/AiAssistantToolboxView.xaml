<UserControl x:Class="Cadoryx.wpf.Views.Toolboxes.AiAssistantToolboxView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
 xmlns:ai="clr-namespace:Cadoryx.AI.Contracts;assembly=Cadoryx.AI.Contracts"
 xmlns:r="clr-namespace:Cadoryx.Lang;assembly=Cadoryx.Lang">
 <Grid Margin="8,6">
  <Grid.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility"/></Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="3,0,3,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="8" Height="8" Margin="0,0,7,0" Fill="{DynamicResource MaterialDesign.Brush.Primary}"/>
    <TextBlock Text="{Binding ConnectionStatus}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></StackPanel>
   <Button Grid.Column="1" Click="OnSettingsClick" ToolTip="{I18N {x:Static r:LangKeys.AiSettings}}"
           Style="{StaticResource MaterialDesignFlatButton}" Width="30" Height="30" Padding="0"><md:PackIcon Kind="CogOutline" Width="17" Height="17"/></Button>
   <Button Grid.Column="2" Command="{Binding ClearConversationCommand}" HorizontalAlignment="Right"
           ToolTip="{I18N {x:Static r:LangKeys.ClearMessages}}" Style="{StaticResource MaterialDesignFlatButton}"
           Width="30" Height="30" Padding="0"><md:PackIcon Kind="DeleteSweepOutline" Width="17" Height="17"/></Button>
  </Grid>
  <ListBox x:Name="ChatList" Grid.Row="1" ItemsSource="{Binding Messages}" BorderThickness="0"
           ScrollViewer.HorizontalScrollBarVisibility="Disabled"
           VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
   <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style></ListBox.ItemContainerStyle>
   <ListBox.ItemTemplate><DataTemplate>
    <Border x:Name="Card" Margin="3,3" Padding="9,7" CornerRadius="6" Background="#12000000">
     <StackPanel><TextBlock Text="{Binding Role}" FontSize="11" Opacity="0.65" Margin="0,0,0,3"/>
      <TextBox Text="{Binding Content,Mode=OneWay}" TextWrapping="Wrap" IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0"/></StackPanel>
    </Border>
    <DataTemplate.Triggers>
     <DataTrigger Binding="{Binding Role}" Value="User"><Setter TargetName="Card" Property="Background" Value="#243F51B5"/></DataTrigger>
     <DataTrigger Binding="{Binding Role}" Value="System"><Setter TargetName="Card" Property="Background" Value="Transparent"/></DataTrigger>
     <DataTrigger Binding="{Binding Role}" Value="Tool"><Setter TargetName="Card" Property="Background" Value="#1828A745"/></DataTrigger>
     <DataTrigger Binding="{Binding Role}" Value="Error"><Setter TargetName="Card" Property="Background" Value="#20D32F2F"/></DataTrigger>
    </DataTemplate.Triggers>
   </DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <Grid Grid.Row="2" Margin="3,6,3,2">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <ItemsControl Grid.ColumnSpan="2" ItemsSource="{Binding Attachments}" Margin="0,0,0,5"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate><DataTemplate><Border Margin="0,0,5,3" Padding="5" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}">
     <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" MaxWidth="135" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      <Button Content="×" Width="22" Height="22" Padding="0" Style="{StaticResource MaterialDesignFlatButton}"
       Command="{Binding DataContext.RemoveAttachmentCommand,RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
   <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Height="2" IsIndeterminate="True" Visibility="{Binding IsBusy,Converter={StaticResource BoolVisibility}}"/>
   <TextBox x:Name="PromptInput" Grid.Row="2" Text="{Binding UserInput,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
            TextWrapping="Wrap" MinHeight="44" MaxHeight="120" VerticalScrollBarVisibility="Auto"
            AutomationProperties.Name="{I18N {x:Static r:LangKeys.AiPrompt}}" KeyDown="OnPromptKeyDown"/>
   <StackPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Bottom" Margin="4,0,0,0">
   <Button Click="OnAttachClick" ToolTip="{I18N {x:Static r:LangKeys.AiAttachFile}}" Style="{StaticResource MaterialDesignFlatButton}" Width="34" Height="34" Padding="0"><md:PackIcon Kind="Paperclip" Width="18" Height="18"/></Button>
   <Button Command="{Binding SendCommand}" ToolTip="{I18N {x:Static r:LangKeys.AiSend}}"
           AutomationProperties.Name="{I18N {x:Static r:LangKeys.AiSend}}"
           Style="{StaticResource MaterialDesignFlatButton}" Width="34" Height="34" Padding="0">
    <md:PackIcon Kind="SendOutline" Width="18" Height="18"/>
   </Button>
   <Button Command="{Binding StopCommand}" ToolTip="{I18N {x:Static r:LangKeys.AiStop}}"
           AutomationProperties.Name="{I18N {x:Static r:LangKeys.AiStop}}"
           Style="{StaticResource MaterialDesignFlatButton}" Width="34" Height="34" Padding="0" Visibility="{Binding IsBusy,Converter={StaticResource BoolVisibility}}">
    <md:PackIcon Kind="Stop" Width="18" Height="18"/>
   </Button>
   </StackPanel>
  </Grid>
 </Grid>
</UserControl>
