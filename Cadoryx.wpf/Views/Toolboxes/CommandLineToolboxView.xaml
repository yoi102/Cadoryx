<UserControl x:Class="Cadoryx.wpf.Views.Toolboxes.CommandLineToolboxView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
 xmlns:r="clr-namespace:Cadoryx.Lang;assembly=Cadoryx.Lang">
 <Grid Margin="8,6">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ListBox x:Name="OutputList" Grid.Row="0" ItemsSource="{Binding Entries}"
           BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
           VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
   <ListBox.ItemTemplate><DataTemplate>
    <Grid Margin="2,3"><Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <TextBlock Text="{Binding Timestamp,StringFormat={}{0:HH:mm:ss}}" Opacity="0.55" FontSize="11"/>
     <TextBlock Grid.Column="1" Text="{Binding Kind}" FontSize="11" Opacity="0.75">
      <TextBlock.Style><Style TargetType="TextBlock">
       <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
       <Style.Triggers>
        <DataTrigger Binding="{Binding Kind}" Value="Error"><Setter Property="Foreground" Value="#E66D78"/></DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Warning"><Setter Property="Foreground" Value="#DDA647"/></DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Action"><Setter Property="Foreground" Value="#579FE8"/></DataTrigger>
       </Style.Triggers>
      </Style></TextBlock.Style>
     </TextBlock>
     <TextBlock Grid.Column="2" Text="{Binding Text}" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas"/>
    </Grid>
   </DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <ListBox x:Name="SuggestionList" Grid.Row="1" ItemsSource="{Binding Suggestions}"
           SelectedItem="{Binding SelectedSuggestion,Mode=TwoWay}" MaxHeight="105" Margin="3,2"
           BorderThickness="0" MouseLeftButtonUp="OnSuggestionMouseUp"/>
  <Grid Grid.Row="2" Margin="3,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBox x:Name="CommandInput" Text="{Binding CommandText,UpdateSourceTrigger=PropertyChanged}"
            AutomationProperties.Name="{I18N {x:Static r:LangKeys.CommandTerminal}}" KeyDown="OnCommandKeyDown"/>
   <Button Grid.Column="1" Command="{Binding ExecuteCommand}" ToolTip="{I18N {x:Static r:LangKeys.CommandRun}}"
           AutomationProperties.Name="{I18N {x:Static r:LangKeys.CommandRun}}"
           Style="{StaticResource MaterialDesignFlatButton}" Width="32" Height="32" Padding="0">
    <md:PackIcon Kind="ArrowRight" Width="18" Height="18"/>
   </Button>
   <Button Grid.Column="2" Command="{Binding ClearCommand}" ToolTip="{I18N {x:Static r:LangKeys.ClearMessages}}"
           Style="{StaticResource MaterialDesignFlatButton}" Width="32" Height="32" Padding="0">
    <md:PackIcon Kind="DeleteSweepOutline" Width="17" Height="17"/>
   </Button>
  </Grid>
 </Grid>
</UserControl>
