<mah:MetroWindow x:Class="Cadoryx.wpf.Views.Toolboxes.AiAssistantSettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
 xmlns:ai="clr-namespace:Cadoryx.AI.Contracts;assembly=Cadoryx.AI.Contracts"
 xmlns:r="clr-namespace:Cadoryx.Lang;assembly=Cadoryx.Lang"
 Style="{StaticResource Cadoryx.DialogWindowStyle}"
 Title="{I18N {x:Static r:LangKeys.AiSettings}}" Width="560" Height="420" MinWidth="480" MinHeight="380"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" AutomationProperties.AutomationId="AiAssistantSettingsWindow">
 <Grid Margin="22,16">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,8,0">
   <TextBlock Text="{I18N {x:Static r:LangKeys.AiSettings}}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
   <TextBlock Text="{I18N {x:Static r:LangKeys.AiProvider}}"/>
   <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding Provider}" Margin="0,4,0,14"/>
   <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers>
    <DataTrigger Binding="{Binding Provider}" Value="{x:Static ai:AiAssistantProvider.Codex}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
   </Style.Triggers></Style></StackPanel.Style>
    <TextBlock Text="{I18N {x:Static r:LangKeys.AiEndpoint}}"/>
    <TextBox Text="{Binding Endpoint,UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12"/>
    <TextBlock Text="{I18N {x:Static r:LangKeys.AiModel}}"/>
    <ComboBox ItemsSource="{Binding Models}" IsEditable="True" Text="{Binding Model,UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,6"/>
   </StackPanel>
   <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
    <DataTrigger Binding="{Binding Provider}" Value="{x:Static ai:AiAssistantProvider.Codex}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
   </Style.Triggers></Style></StackPanel.Style>
    <TextBlock Text="{I18N {x:Static r:LangKeys.AiCodexExecutable}}"/>
    <TextBox Text="{Binding CodexExecutablePath,UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12"/>
    <TextBlock Text="{I18N {x:Static r:LangKeys.AiCodexModel}}"/>
    <ComboBox ItemsSource="{Binding Models}" IsEditable="True" Text="{Binding CodexModel,UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12"/>
    <TextBlock Text="{I18N {x:Static r:LangKeys.AiReasoning}}"/>
    <ComboBox ItemsSource="{Binding ReasoningEffortOptions}"
              SelectedItem="{Binding ReasoningEffort,Mode=TwoWay}" Margin="0,4,0,8"/>
   </StackPanel>
   <Button Content="{I18N {x:Static r:LangKeys.AiLoadModels}}" Command="{Binding LoadModelsCommand}" HorizontalAlignment="Left" Margin="0,3,0,14"/>
   <CheckBox Content="{I18N {x:Static r:LangKeys.AiEnableCadTools}}" IsChecked="{Binding EnableCadTools}"/>
   <TextBlock Text="{Binding ConnectionStatus}" Margin="0,12,0,0" TextWrapping="Wrap" Opacity="0.7"/>
  </StackPanel></ScrollViewer>
  <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
   <Button Content="{I18N {x:Static r:LangKeys.Cancel}}" IsCancel="True" MinWidth="84" Margin="0,0,8,0"/>
   <Button Content="{I18N {x:Static r:LangKeys.Save}}" Click="OnSaveClick" MinWidth="84"/>
  </StackPanel>
 </Grid>
</mah:MetroWindow>
