<UserControl x:Class="Cadoryx.wpf.Views.Toolboxes.MessagesToolboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:r="clr-namespace:Cadoryx.Lang;assembly=Cadoryx.Lang"
             xmlns:vm="clr-namespace:Cadoryx.ViewModels.Toolboxes;assembly=Cadoryx.ViewModels"
             xmlns:notificationVm="clr-namespace:Cadoryx.ViewModels.Services.Platform.Notifications;assembly=Cadoryx.ViewModels.Services"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MessagesToolboxViewModel}">
    <Grid Margin="8,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="2,0,0,4">
            <TextBlock Text="{I18N {x:Static r:LangKeys.Messages}}"
                       FontSize="13"
                       FontWeight="SemiBold" />
            <Button DockPanel.Dock="Right"
                    Command="{Binding ClearCommand}"
                    ToolTip="{I18N {x:Static r:LangKeys.ClearMessages}}"
                    Content="{md:PackIcon Kind=DeleteSweepOutline, Size=17}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Width="28"
                    Height="28"
                    Padding="0" />
        </DockPanel>
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Messages}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type notificationVm:CadMessageEntry}">
                    <Border BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}"
                            BorderThickness="0,0,0,1"
                            Padding="2,5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Level}"
                                       Width="90"
                                       Opacity="0.7" />
                            <TextBlock Text="{Binding Text}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
