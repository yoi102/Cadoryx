<mah:MetroWindow x:Class="Cadoryx.wpf.Views.HistoryQueryWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
 Style="{StaticResource Cadoryx.DialogWindowStyle}" Title="{Binding Labels.Title}"
 Width="860" Height="740" MinWidth="690" MinHeight="570" WindowStartupLocation="CenterOwner">
 <Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <StackPanel Margin="0,0,16,0">
   <TextBlock Text="{Binding Labels.Saved}" Margin="0,0,0,8"/>
   <ListBox ItemsSource="{Binding Queries}" SelectedItem="{Binding SelectedQuery}" DisplayMemberPath="Name" MinHeight="250"/>
   <Button Content="{Binding Labels.New}" Command="{Binding NewQueryCommand}" Margin="0,10,0,0"/>
   <Button Content="{Binding Labels.Delete}" Command="{Binding DeleteCommand}" Margin="0,10,0,0"/>
  </StackPanel>
  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="0,0,8,0">
   <TextBlock Text="{Binding Labels.Name}"/>
   <TextBox Text="{Binding QueryName,UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12"/>
   <TextBlock Text="{Binding Labels.Source}"/>
   <TextBlock Text="{Binding DraftSourceLabel}" Margin="0,4,0,5" TextWrapping="Wrap"/>
   <DockPanel>
    <Button DockPanel.Dock="Right" Content="{Binding Labels.Reselect}" Command="{Binding ReselectSourceCommand}" Margin="8,0,0,0"/>
    <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" DisplayMemberPath="Label"/>
   </DockPanel>
   <TextBlock Text="{Binding Labels.Target}" Margin="0,14,0,0"/>
   <TextBlock Text="{Binding DraftTargetLabel}" Margin="0,4,0,5" TextWrapping="Wrap"/>
   <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" DisplayMemberPath="Label"/>
   <WrapPanel Margin="0,14,0,10">
    <Button Content="{Binding Labels.Save}" Command="{Binding SaveCommand}" Margin="0,0,8,0"/>
    <Button Content="{Binding Labels.Analyze}" Command="{Binding AnalyzeCommand}"/>
   </WrapPanel>
   <TextBlock Text="{Binding ResultSummary}" TextWrapping="Wrap" MinHeight="48"/>
   <TextBlock Text="{Binding Labels.Radius}" Margin="0,8,0,4"/>
   <TextBox Text="{Binding Radius,UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left"/>
   <Button Content="{Binding Labels.CreateFillet}" Command="{Binding CreateFilletCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
   <TextBlock Text="{Binding Labels.StaleConsumer}" Margin="0,10,0,4"/>
   <ComboBox ItemsSource="{Binding StaleConsumers}" SelectedItem="{Binding SelectedStaleConsumer}" DisplayMemberPath="Label"/>
   <Button Content="{Binding Labels.Rebind}" Command="{Binding RebindFilletCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
   <TextBlock Text="{Binding Labels.Steps}" Margin="0,10,0,4"/>
   <ListBox ItemsSource="{Binding Steps}" Height="120">
    <ListBox.ItemTemplate>
     <DataTemplate><StackPanel Orientation="Horizontal">
      <TextBlock Text="{Binding Number}" Width="28"/>
      <TextBlock Text="{Binding Feature}" Width="200" TextTrimming="CharacterEllipsis"/>
      <TextBlock Text="{Binding Input}" Width="65"/>
      <TextBlock Text="{Binding State}"/>
     </StackPanel></DataTemplate>
    </ListBox.ItemTemplate>
   </ListBox>
  </StackPanel>
  </ScrollViewer>
  <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,12,0,0"/>
 </Grid>
</mah:MetroWindow>
