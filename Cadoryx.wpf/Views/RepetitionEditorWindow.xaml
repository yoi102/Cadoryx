<mah:MetroWindow x:Class="Cadoryx.wpf.Views.RepetitionEditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
 xmlns:r="clr-namespace:Cadoryx.Lang;assembly=Cadoryx.Lang"
 Style="{StaticResource Cadoryx.DialogWindowStyle}" Title="{I18N {x:Static r:LangKeys.Repetition}}"
 Width="820" Height="800" MinWidth="700" MinHeight="650" WindowStartupLocation="CenterOwner">
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" Margin="0,0,0,12"/>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding CanEdit}">
   <StackPanel>
    <TextBlock Text="{I18N {x:Static r:LangKeys.RepetitionFeature}}"/>
    <ComboBox x:Name="FeaturePicker" ItemsSource="{Binding Features}" SelectedItem="{Binding SelectedFeature}" DisplayMemberPath="Label" Margin="0,4,0,10"/>
    <TextBlock Text="{I18N {x:Static r:LangKeys.RepetitionSource}}"/>
    <ComboBox x:Name="SourcePicker" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" DisplayMemberPath="Label" IsEnabled="{Binding CanChooseSource}" Margin="0,4,0,10"/>
    <TextBlock Text="{Binding SourceDescription}" Margin="0,0,0,6"/>
    <CheckBox x:Name="ReplayHoleInput" Content="{I18N {x:Static r:LangKeys.RepetitionReplayHole}}" IsChecked="{Binding ReplayHole}" IsEnabled="{Binding CanSetReplay}" Margin="0,0,0,8"/>
    <CheckBox x:Name="ReplayExtrusionInput" Content="{I18N {x:Static r:LangKeys.RepetitionReplayExtrusion}}" IsChecked="{Binding ReplayExtrusion}" IsEnabled="{Binding CanSetReplay}" Margin="0,0,0,10"/>
    <TextBlock Text="{I18N {x:Static r:LangKeys.Name}}"/>
    <TextBox x:Name="NameInput" Text="{Binding ObjectName,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsNew}" Margin="0,4,0,10"/>
    <UniformGrid Columns="2">
     <StackPanel Margin="0,0,12,10"><TextBlock Text="{I18N {x:Static r:LangKeys.RepetitionKind}}"/>
      <ComboBox x:Name="KindPicker" ItemsSource="{Binding Kinds}" SelectedValuePath="Value" SelectedValue="{Binding Kind}" DisplayMemberPath="Label" IsEnabled="{Binding CanChangeKind}" Margin="0,4,0,0"/>
     </StackPanel>
     <StackPanel Margin="0,0,0,10"><TextBlock Text="{I18N {x:Static r:LangKeys.RepetitionOutput}}"/>
      <ComboBox x:Name="OutputPicker" ItemsSource="{Binding Outputs}" SelectedValuePath="Value" SelectedValue="{Binding Output}" DisplayMemberPath="Label" IsEnabled="{Binding CanSetOutput}" Margin="0,4,0,0"/>
     </StackPanel>
    </UniformGrid>
    <TextBlock Text="{I18N {x:Static r:LangKeys.RepetitionStylePolicy}}"/>
    <ComboBox x:Name="StylePolicyPicker" ItemsSource="{Binding StylePolicies}" SelectedValuePath="Value" SelectedValue="{Binding StylePolicy}" DisplayMemberPath="Label" IsEnabled="{Binding CanSetStylePolicy}" Margin="0,4,0,8"/>
    <TextBlock Text="{I18N {x:Static r:LangKeys.RepetitionStyleHint}}" TextWrapping="Wrap" Margin="0,0,0,8"/>
    <TextBlock Text="{Binding PresentationSummary}" TextWrapping="Wrap" Margin="0,0,0,10"/>
    <UniformGrid Columns="2">
     <StackPanel Margin="0,0,12,10"><TextBlock Text="{Binding CountLabel}" TextWrapping="Wrap"/>
      <mah:NumericUpDown x:Name="CountInput" Value="{Binding Count}" Minimum="1" Maximum="256" Interval="1" NumericInputMode="Numbers" IsEnabled="{Binding IsArray}" Margin="0,4,0,0"/>
     </StackPanel>
     <StackPanel Margin="0,0,0,10"><TextBlock Text="{Binding StepLabel}"/>
      <mah:NumericUpDown x:Name="StepInput" Value="{Binding Step}" IsEnabled="{Binding CanSetStep}" Margin="0,4,0,0"/>
     </StackPanel>
    </UniformGrid>
    <CheckBox x:Name="IncludeSourceInput" Content="{Binding IncludeSourceLabel}" IsChecked="{Binding IncludeSource}" IsEnabled="{Binding CanSetIncludeSource}" Margin="0,0,0,8"/>
    <CheckBox x:Name="FullCircleInput" Content="{I18N {x:Static r:LangKeys.RepetitionFullCircle}}" IsChecked="{Binding FullCircle}" IsEnabled="{Binding IsCircular}" Margin="0,0,0,12">
     <CheckBox.Style><Style TargetType="CheckBox"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsCircular}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></CheckBox.Style>
    </CheckBox>
    <TextBlock Text="{I18N {x:Static r:LangKeys.RepetitionFrame}}"/>
    <ComboBox x:Name="DatumPicker" ItemsSource="{Binding Datums}" SelectedItem="{Binding SelectedDatum}" DisplayMemberPath="Label" Margin="0,4,0,12"/>
    <TextBlock Text="{I18N {x:Static r:LangKeys.RepetitionFrameHint}}" TextWrapping="Wrap" Margin="0,0,0,10"/>
    <UniformGrid Columns="3" IsEnabled="{Binding CanSetFrame}">
     <StackPanel Margin="0,0,10,10"><TextBlock Text="X (mm)"/><mah:NumericUpDown x:Name="OriginXInput" Value="{Binding OriginX}" Minimum="-1000000" Maximum="1000000"/></StackPanel>
     <StackPanel Margin="0,0,10,10"><TextBlock Text="Y (mm)"/><mah:NumericUpDown Value="{Binding OriginY}" Minimum="-1000000" Maximum="1000000"/></StackPanel>
     <StackPanel Margin="0,0,0,10"><TextBlock Text="Z (mm)"/><mah:NumericUpDown Value="{Binding OriginZ}" Minimum="-1000000" Maximum="1000000"/></StackPanel>
     <StackPanel Margin="0,0,10,10"><TextBlock Text="Rx (°)"/><mah:NumericUpDown Value="{Binding RotationX}" Minimum="-3600" Maximum="3600"/></StackPanel>
     <StackPanel Margin="0,0,10,10"><TextBlock Text="Ry (°)"/><mah:NumericUpDown x:Name="RotationYInput" Value="{Binding RotationY}" Minimum="-3600" Maximum="3600"/></StackPanel>
     <StackPanel Margin="0,0,0,10"><TextBlock Text="Rz (°)"/><mah:NumericUpDown Value="{Binding RotationZ}" Minimum="-3600" Maximum="3600"/></StackPanel>
    </UniformGrid>
   </StackPanel>
  </ScrollViewer>
  <TextBlock Grid.Row="2" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,12"/>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
   <Button x:Name="PreviewButton" Content="{I18N {x:Static r:LangKeys.SolveAndPreview}}" Command="{Binding PreviewCommand}" Margin="0,0,8,0"/>
   <Button x:Name="ConfirmButton" Content="{I18N {x:Static r:LangKeys.Confirm}}" Command="{Binding ConfirmCommand}" Margin="0,0,8,0"/>
   <Button x:Name="CancelButton" Content="{I18N {x:Static r:LangKeys.Cancel}}" Command="{Binding CancelCommand}"/>
  </StackPanel>
 </Grid>
</mah:MetroWindow>
