<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><PlatformTarget>x64</PlatformTarget>
    <AssemblyName>CadAgentWorkflowProbe</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Cadoryx.ViewModels/Cadoryx.ViewModels.csproj" />
    <ProjectReference Include="../../Cadoryx.IO/Cadoryx.IO.csproj" />
    <ProjectReference Include="../../Cadoryx.Kernel.Occt/Cadoryx.Kernel.Occt.csproj" />
    <PackageReference Include="OcctSharp.Native.win-x64" Version="[$(OcctSharpVersion)]" />
    <Compile Include="$(RawProgramSource)" Link="Program.cs" />
    <Compile Include="../CadAgentWorkflowProbe/DrawingProviderProbe.cs" Link="DrawingProviderProbe.cs" />
    <Compile Include="../CadAgentWorkflowProbe/WorkspaceProviderProbe.cs" Link="WorkspaceProviderProbe.cs" />
  </ItemGroup>
  <Target Name="RequireOwnedRawProjection" BeforeTargets="CoreCompile">
    <Error Condition="'$(RawProgramSource)' == '' or !Exists('$(RawProgramSource)')" Text="Generate a fresh owned raw-response projection and pass RawProgramSource." />
  </Target>
</Project>
