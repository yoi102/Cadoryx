<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType></PropertyGroup>
  <ItemGroup>
    <Reference Include="$(CandidatePayload)/*.dll"><Private>true</Private></Reference>
    <Content Include="$(CandidatePayload)/occt/*.*"><Link>occt/%(Filename)%(Extension)</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="$(CandidatePayload)/Cadoryx.wpf.exe;$(CandidatePayload)/Cadoryx.wpf.deps.json;$(CandidatePayload)/Cadoryx.wpf.runtimeconfig.json"><Link>%(Filename)%(Extension)</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="$(CandidatePayload)/**/*.resources.dll"><Link>%(RecursiveDir)%(Filename)%(Extension)</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
  </ItemGroup>
</Project>
