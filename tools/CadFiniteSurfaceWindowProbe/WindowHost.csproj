<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors><EnableNETAnalyzers>false</EnableNETAnalyzers>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(CandidatePayload)/*.dll"><Private>true</Private></Reference>
    <Content Include="$(CandidatePayload)/Cadoryx.wpf.exe;$(CandidatePayload)/Cadoryx.wpf.deps.json;$(CandidatePayload)/Cadoryx.wpf.runtimeconfig.json"><Link>%(Filename)%(Extension)</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="$(CandidatePayload)/occt/*.*"><Link>occt/%(Filename)%(Extension)</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="$(CandidatePayload)/**/*.resources.dll"><Link>%(RecursiveDir)%(Filename)%(Extension)</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
  </ItemGroup>
  <Target Name="ValidateCandidatePayload" BeforeTargets="ResolveReferences">
    <Error Condition="'$(CandidatePayload)' == ''" Text="Provide CandidatePayload pointing to the frozen WPF build output." />
    <Error Condition="!Exists('$(CandidatePayload)/Cadoryx.wpf.exe') Or !Exists('$(CandidatePayload)/Cadoryx.wpf.deps.json') Or !Exists('$(CandidatePayload)/Cadoryx.wpf.runtimeconfig.json')" Text="The candidate payload must include the production worker executable and its runtime configuration." />
  </Target>
</Project>
