<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Cadoryx.Tests</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(CandidateTests)/*.dll" Exclude="$(CandidateTests)/Cadoryx.Tests.dll;$(CandidateTests)/Cadoryx.ViewModels.dll"><Private>true</Private></Reference>
    <Reference Include="$(CandidateViewModels)"><Private>true</Private></Reference>
    <Compile Include="InspectionDocumentIdentityFeedbackTests.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="$(CandidateSource)/Cadoryx.Tests/AgentCommandCatalogTests.cs" />
    <Compile Include="$(CandidateSource)/Cadoryx.Tests/DrawingLegacyViewPathFeedbackTests.cs" />
    <Compile Include="$(CandidateSource)/Cadoryx.Tests/DrawingInspectionTypeFeedbackTests.cs" />
  </ItemGroup>
</Project>
