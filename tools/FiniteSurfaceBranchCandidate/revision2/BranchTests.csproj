<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Cadoryx.Tests</AssemblyName><PlatformTarget>x64</PlatformTarget>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="KernelBranchCandidate.csproj" />
    <Reference Include="$(CandidateTests)/*.dll" Exclude="$(CandidateTests)/Cadoryx.Tests.dll;$(CandidateTests)/Cadoryx.Kernel.Occt.dll"><Private>true</Private></Reference>
    <Compile Include="$(CandidateSource)/Cadoryx.Tests/**/*.cs" Exclude="$(CandidateSource)/Cadoryx.Tests/bin/**/*.cs;$(CandidateSource)/Cadoryx.Tests/obj/**/*.cs" />
    <Compile Include="FiniteSurfaceAnalyticBranchTests.cs" />
    <Content Include="$(CandidateTests)/occt/*.*"><Link>occt/%(Filename)%(Extension)</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="$(CandidateTests)/testhost.*"><Link>%(Filename)%(Extension)</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="$(CandidateTests)/Fixtures/**/*"><Link>Fixtures/%(RecursiveDir)%(Filename)%(Extension)</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
  </ItemGroup>
</Project>
